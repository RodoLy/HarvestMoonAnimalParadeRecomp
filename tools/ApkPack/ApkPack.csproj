<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ApkPack: puts the compiled game into the Android app and signs it (Program.cs).
    ApkPack: mete el juego compilado en la app de Android y la firma.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>ApkPack</AssemblyName>
    <RootNamespace>ApkPack</RootNamespace>
  </PropertyGroup>

</Project>
