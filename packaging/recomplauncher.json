{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "repo": "RodoLy/HarvestMoonAnimalParadeRecomp",
  "name": "Harvest Moon: Animal Parade",
  "game": {
    "kind": "iso_or_folder",
    "label": "Your disc image of Harvest Moon: Animal Parade, USA release (RBIEE9): .rvz, .iso, .wbfs, .wia, .gcz or .ciso, or a folder Dolphin extracted.",
    "check": {
      "ids": [
        "RBIEE9"
      ]
    }
  },
  "prepare": {
    "program": [
      "recomplauncher-setup.cmd",
      "play.sh"
    ],
    "args": [
      "--disc",
      "{game}",
      "--no-start",
      "--progress"
    ],
    "label": "Building the game from your disc (the first time takes a while)",
    "timeout": 10800,
    "done": [
      "{install}/Game/dsp_coef.bin"
    ],
    "version": "0.2.0"
  },
  "start": {
    "program": [
      "Game/AnimalParade.exe",
      "Game/AnimalParade",
      "Launcher.exe",
      "AnimalParadeLauncher"
    ]
  },
  "config": [
    {
      "id": "main",
      "format": "toml",
      "file": [
        {
          "path": "{install}/UserData/Config.toml"
        }
      ]
    }
  ],
  "settings": [
    {
      "id": "picture",
      "label": "Picture",
      "help": "Wide fills a widescreen window: the 3D cameras see more at the sides and the menus keep their shape.",
      "group": "Video",
      "choices": [
        {
          "label": "Original (4:3)",
          "set": {
            "video/widescreen": "false"
          }
        },
        {
          "label": "Wide",
          "set": {
            "video/widescreen": "true"
          }
        }
      ],
      "defaults": {
        "video/widescreen": "false"
      }
    },
    {
      "id": "resolution",
      "label": "Resolution",
      "help": "The game draws at the Wii's 480p unless you pick more. More looks sharper and asks more of the graphics card; 4K fills a 4K screen.",
      "group": "Video",
      "choices": [
        {
          "label": "Original (480p)",
          "set": {
            "video/resolution_multiplier": "1.0"
          }
        },
        {
          "label": "The window's",
          "set": {
            "video/resolution_multiplier": "0.0"
          }
        },
        {
          "label": "720p",
          "set": {
            "video/resolution_multiplier": "1.5"
          }
        },
        {
          "label": "960p",
          "set": {
            "video/resolution_multiplier": "2.0"
          }
        },
        {
          "label": "1440p",
          "set": {
            "video/resolution_multiplier": "3.0"
          }
        },
        {
          "label": "4K",
          "set": {
            "video/resolution_multiplier": "5.0"
          }
        }
      ],
      "defaults": {
        "video/resolution_multiplier": "1.0"
      }
    },
    {
      "id": "interpolation",
      "label": "Frame interpolation",
      "help": "The game runs at 30 FPS; interpolation shows more frames without changing its speed.",
      "group": "Video",
      "choices": [
        {
          "label": "Off",
          "set": {
            "video/frame_interpolation_fps": "0"
          }
        },
        {
          "label": "60 FPS",
          "set": {
            "video/frame_interpolation_fps": "60"
          }
        },
        {
          "label": "120 FPS",
          "set": {
            "video/frame_interpolation_fps": "120"
          }
        },
        {
          "label": "180 FPS",
          "set": {
            "video/frame_interpolation_fps": "180"
          }
        }
      ],
      "defaults": {
        "video/frame_interpolation_fps": "0"
      }
    },
    {
      "id": "fullscreen",
      "label": "Fullscreen",
      "help": "The game fills the whole screen.",
      "group": "Video",
      "choices": [
        {
          "label": "Off",
          "set": {
            "video/display_mode": "\"windowed\""
          }
        },
        {
          "label": "On",
          "set": {
            "video/display_mode": "\"borderless\""
          }
        }
      ],
      "defaults": {
        "video/display_mode": "\"windowed\""
      }
    },
    {
      "id": "controller_buttons",
      "label": "Controller buttons",
      "help": "Your controller's buttons for the Wii Remote and the Nunchuk; the Nunchuk stick is the left stick. Press a box, then a button on your controller. Keys are set in the game's F10 menu.",
      "group": "Controls",
      "bindings": {
        "separator": ",",
        "max": 2,
        "actions": [
          {
            "label": "A",
            "key": "controller/a",
            "pad": true
          },
          {
            "label": "B",
            "key": "controller/b",
            "pad": true
          },
          {
            "label": "1",
            "key": "controller/x",
            "pad": true
          },
          {
            "label": "2",
            "key": "controller/y",
            "pad": true
          },
          {
            "label": "+ (Plus)",
            "key": "controller/start",
            "pad": true
          },
          {
            "label": "− (Minus)",
            "key": "controller/z",
            "pad": true
          },
          {
            "label": "Nunchuk Z",
            "key": "controller/l",
            "pad": true
          },
          {
            "label": "Nunchuk C",
            "key": "controller/r",
            "pad": true
          },
          {
            "label": "D-pad up",
            "key": "controller/up",
            "pad": true
          },
          {
            "label": "D-pad down",
            "key": "controller/down",
            "pad": true
          },
          {
            "label": "D-pad left",
            "key": "controller/left",
            "pad": true
          },
          {
            "label": "D-pad right",
            "key": "controller/right",
            "pad": true
          }
        ]
      },
      "defaults": {
        "controller/a": "A",
        "controller/b": "B",
        "controller/x": "X",
        "controller/y": "Y",
        "controller/start": "Start",
        "controller/z": "RB",
        "controller/l": "LT",
        "controller/r": "RT",
        "controller/up": "D-Pad Up",
        "controller/down": "D-Pad Down",
        "controller/left": "D-Pad Left",
        "controller/right": "D-Pad Right"
      }
    },
    {
      "id": "romance_any_gender",
      "label": "Romance for everyone",
      "help": "Any bachelor or bachelorette can fall in love with you and marry you, boy or girl.",
      "group": "Mods",
      "choices": [
        {
          "label": "Off",
          "set": {
