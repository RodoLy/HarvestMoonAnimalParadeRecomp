diff --git a/Launcher/NativeBuildFlags.ps1 b/Launcher/NativeBuildFlags.ps1
index 9cf4318..38c3d0f 100644
--- a/Launcher/NativeBuildFlags.ps1
+++ b/Launcher/NativeBuildFlags.ps1
@@ -205,6 +205,29 @@ function Invoke-Checked([string]$FilePath, [string[]]$Arguments, [string]$Descri
     if ($exitCode -ne 0) { throw "$Description failed with exit code $exitCode." }
 }
 
+function Get-MkwToolchainProcessor([string]$ToolchainBin) {
+    <#
+    The processor the portable llvm-mingw runs on, and so the one the game is built for: 'aarch64' for the
+    Windows on ARM toolkit, 'x86_64' otherwise. Read from the machine field of the compiler's PE header,
+    because both llvm-mingw packages carry cross compilers for every target.
+    #>
+    $clang = Join-Path $ToolchainBin 'clang-22.exe'
+    $stream = [IO.File]::OpenRead($clang)
+    try {
+        $header = New-Object byte[] 4096
+        [void]$stream.Read($header, 0, $header.Length)
+    } finally { $stream.Dispose() }
+    $machine = [BitConverter]::ToUInt16($header, [BitConverter]::ToInt32($header, 0x3C) + 4)
+    if ($machine -eq 0xAA64) { return 'aarch64' }
+    return 'x86_64'
+}
+
+function Get-MkwTargetProcessor {
+    # Set by the scripts that pick a toolchain, before any flags are built.
+    if ($env:MKW_TARGET_PROCESSOR) { return $env:MKW_TARGET_PROCESSOR }
+    return 'x86_64'
+}
+
 function Get-MkwNativeFixedConfigureFlags {
     <#
     The path-independent half of the configure command line, identical on every machine, which is
@@ -213,7 +236,7 @@ function Get-MkwNativeFixedConfigureFlags {
     #>
     return @(
         '-DCMAKE_BUILD_TYPE=Release',
-        '-DCMAKE_SYSTEM_PROCESSOR=x86_64',
+        ('-DCMAKE_SYSTEM_PROCESSOR=' + (Get-MkwTargetProcessor)),
         '-DAURORA_DAWN_PROVIDER=package', '-DAURORA_SDL3_PROVIDER=vendor',
         '-DCMAKE_POLICY_DEFAULT_CMP0168=NEW', '-DFETCHCONTENT_FULLY_DISCONNECTED=ON',
         '-DAWK:FILEPATH='
