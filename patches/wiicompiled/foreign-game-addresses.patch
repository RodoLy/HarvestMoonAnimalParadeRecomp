+
+std::string WithSameSexLines(const std::string& pack, const std::string& language, const std::string& folder,
+                             const std::string& name, int& fixed) {
+    // Only the packs a couple of the same sex sees, and that have fixes.
+    if (folder != (WomanCandidate(name) ? "female" : "male")) {
+        return pack;
+    }
+    bool any = false;
+    for (const LineFix& fix : kFixes) {
+        any = any || (language == fix.language && name == fix.pack);
+    }
+    if (!any) {
+        return pack;
+    }
+    if (pack.size() < 0x14 || pack.compare(0, 4, "MSGP") != 0) {
+        return pack;
+    }
+    const uint32_t count = ReadBigEndian32(pack, 8);
+    const uint32_t data = ReadBigEndian32(pack, 0x10);
+    if (data > pack.size() || 0x14 + 12 * size_t(count) > data) {
+        return pack;
+    }
+    // The pack ("MSGP": a count at 8, the rows {message, offset, size} from 0x14, then the
+    // messages from the offset at 0x10), rebuilt with each message as it is or fixed. A message
+    // ("MSGB") keeps its header: its line breaks, pages and most line breaks in a page stay (no
+    // fix adds a line), the longest line grows with the fix, the text's size is the new one.
+    std::string rows = pack.substr(0x14, 12 * size_t(count));
+    std::string messages;
+    for (uint32_t i = 0; i < count; ++i) {
+        const uint32_t id = ReadBigEndian32(rows, 12 * size_t(i));
+        const size_t at = data + ReadBigEndian32(rows, 12 * size_t(i) + 4);
+        const size_t size = ReadBigEndian32(rows, 12 * size_t(i) + 8);
+        if (at + size > pack.size()) {
+            return pack;
+        }
+        std::string entry = pack.substr(at, size);
+        std::string text;
+        bool changed = false;
+        for (const LineFix& fix : kFixes) {
+            if (fix.message != id || language != fix.language || name != fix.pack) {
+                continue;
+            }
+            if (!changed) {
+                const uint32_t start = ReadBigEndian32(entry, 0x18);
+                const uint32_t length = ReadBigEndian32(entry, 0x1C);
+                if (entry.size() < 0x20 || start + size_t(length) > entry.size()) {
+                    break;
+                }
+                text = Utf8(entry.substr(start, length));
+            }
+            const std::string from = fix.from;
+            const std::string to = fix.to;
+            size_t found = text.find(from);
+            if (found == std::string::npos) {
+                std::fprintf(stderr, "[mod %s] lines: %s love%s.mpc message %u has no \"%s\"; left as is\n", kMod,
+                             language.c_str(), name.c_str(), id, fix.from);
+                continue;
+            }
+            for (; found != std::string::npos; found = text.find(from, found + to.size())) {
+                text.replace(found, from.size(), to);
+            }
+            changed = true;
+            ++fixed;
+        }
+        if (changed) {
+            const uint32_t start = ReadBigEndian32(entry, 0x18);
+            const std::string original = Utf8(entry.substr(start, ReadBigEndian32(entry, 0x1C)));
+            const uint32_t longest = ReadBigEndian32(entry, 0x10);
+            const uint32_t before = LongestLine(original);
+            const uint32_t after = LongestLine(text);
+            const std::string utf16 = Utf16(text);
+            entry = entry.substr(0, start) + utf16;
+            PutBigEndian32(entry, 0x10, after > before ? longest + (after - before) : longest);
+            PutBigEndian32(entry, 0x1C, static_cast<uint32_t>(utf16.size()));
+        }
+        PutBigEndian32(rows, 12 * size_t(i) + 4, static_cast<uint32_t>(messages.size()));
+        PutBigEndian32(rows, 12 * size_t(i) + 8, static_cast<uint32_t>(entry.size()));
+        messages += entry;
+    }
+    return pack.substr(0, 0x14) + rows + messages;
+}
