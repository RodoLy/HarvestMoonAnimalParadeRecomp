diff --git a/runtime/include/bluetooth/emulated_remote.h b/runtime/include/bluetooth/emulated_remote.h
new file mode 100644
index 0000000..92e58ff
--- /dev/null
+++ b/runtime/include/bluetooth/emulated_remote.h
@@ -0,0 +1,113 @@
+#pragma once
+
+// A Wii Remote with a Nunchuk, made from the PC's own controls, for a game that needs one and has no
+// real remote on the PC. It speaks the remote's HID protocol to the game's Bluetooth stack the way a
+// physical remote does through RemoteHost: the game asks for a reporting mode, reads the calibration
+// and the extension's ID, switches the IR camera on, and the remote answers with input reports.
+// Pure host code, like bt_controller.h: no guest memory and no SDL, so it is unit-testable.
+// emulated_remote_host.cpp feeds it the GameCube pad mapping and the mouse.
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <optional>
+#include <vector>
+
+namespace Bluetooth {
+
+// Core buttons, as the remote reports them: the first report byte in the high half, the second in the
+// low half.
+namespace RemoteButton {
+inline constexpr uint16_t kLeft = 0x0100;
+inline constexpr uint16_t kRight = 0x0200;
+inline constexpr uint16_t kDown = 0x0400;
+inline constexpr uint16_t kUp = 0x0800;
+inline constexpr uint16_t kPlus = 0x1000;
+inline constexpr uint16_t kTwo = 0x0001;
+inline constexpr uint16_t kOne = 0x0002;
+inline constexpr uint16_t kB = 0x0004;
+inline constexpr uint16_t kA = 0x0008;
+inline constexpr uint16_t kMinus = 0x0010;
+inline constexpr uint16_t kHome = 0x0080;
+} // namespace RemoteButton
+
+// What the player is doing with the emulated remote this moment.
+struct EmulatedInput {
+    uint16_t buttons = 0;  // RemoteButton bits
+    // Where the remote points, -1..1 from the left and top edges of the screen to the right and
+    // bottom ones; off the screen when pointerValid is false.
+    bool pointerValid = false;
+    float pointerX = 0.0f;
+    float pointerY = 0.0f;
+    // The Nunchuk's stick, -1..1 to the right and up, and its two buttons.
+    float stickX = 0.0f;
+    float stickY = 0.0f;
+    bool c = false;
+    bool z = false;
+};
+
+// A GameCube pad as Aurora's PADRead and the runtime's input bindings give it.
+struct GameCubePad {
+    bool connected = false;
+    uint16_t buttons = 0;  // PAD_BUTTON_* / PAD_TRIGGER_* bits
+    int8_t stickX = 0;
+    int8_t stickY = 0;
+    int8_t substickX = 0;
+    int8_t substickY = 0;
+    uint8_t triggerL = 0;
+    uint8_t triggerR = 0;
+};
+
+// The GameCube layout of the emulated remote: stick -> Nunchuk stick, A -> A, B -> B, X -> 1, Y -> 2,
+// L -> Z, R -> C, Start -> +, Z -> -, Start and Z together -> Home, D-pad and C-stick -> D-pad.
+EmulatedInput MapGameCubePad(const GameCubePad& pad);
+
+class EmulatedRemote {
+public:
+    EmulatedRemote();
+
+    // A fresh connection: reporting mode 0x30, IR off, the extension not set up yet.
+    void Reset();
+    void SetInput(const EmulatedInput& input);
+    // An output report from the game (report id first).
+    void HandleOutputReport(const uint8_t* report, size_t size);
+    // The next input report (report id first): an answer to the game first, then the controls in the
+    // reporting mode, at most every 5 ms when continuous and only on a change otherwise.
+    bool PopInputReport(std::vector<uint8_t>& report, uint64_t nowUs);
+
+    uint8_t Leds() const { return m_leds; }
+    uint8_t ReportingMode() const { return m_mode; }
+    bool IrCameraOn() const { return m_irCamera; }
+
+private:
+    void QueueAcknowledge(uint8_t reportId, uint8_t error);
+    void QueueStatus();
+    void WriteMemory(const uint8_t* payload, size_t size);
+    void ReadMemory(const uint8_t* payload, size_t size);
+    std::vector<uint8_t> InputReport() const;
+    void AppendButtons(std::vector<uint8_t>& out) const;
+    void AppendAccelerometer(std::vector<uint8_t>& out) const;
+    void AppendIr(std::vector<uint8_t>& out, size_t bytes) const;
+    void AppendExtension(std::vector<uint8_t>& out, size_t bytes) const;
+    bool ExtensionEncrypted() const;
+
+    EmulatedInput m_input;
+    std::deque<std::vector<uint8_t>> m_answers;
+    std::vector<uint8_t> m_lastReport;
+    uint64_t m_lastReportUs = 0;
+    bool m_reportPending = false;
+
+    uint8_t m_leds = 0;
+    uint8_t m_mode = 0x30;
+    bool m_continuous = false;
+    bool m_irClock = false;
+    bool m_irCamera = false;
+    bool m_speaker = false;
+
+    std::array<uint8_t, 0x1700> m_eeprom{};
+    std::array<uint8_t, 0x100> m_extension{};  // registers 0xA400xx
+    std::array<uint8_t, 0x40> m_camera{};      // registers 0xB000xx
+};
+
+} // namespace Bluetooth
