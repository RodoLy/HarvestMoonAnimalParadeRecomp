+    size_t used = 0;
+    for (int attr = GX_VA_PNMTXIDX; attr <= GX_VA_TEX7 && used < sizeof(layout) - 16; ++attr) {
+        const GXAttrType type = g_hleGxState.vtxDesc[attr];
+        if (type == GX_NONE) continue;
