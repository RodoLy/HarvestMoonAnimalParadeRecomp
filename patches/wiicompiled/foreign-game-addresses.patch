index 0000000..0c4e3a9
--- /dev/null
+++ b/runtime/tests/emulated_remote_tests.cpp
@@ -0,0 +1,193 @@
+// The emulated Wii Remote (bluetooth/emulated_remote.h) answers the game the way a real remote with a
+// Nunchuk does. Each test plays the game's side of one exchange.
+
+#include "bluetooth/emulated_remote.h"
+
+#include <cstdio>
+#include <vector>
+
+namespace {
+
+using Bytes = std::vector<uint8_t>;
+using Bluetooth::EmulatedInput;
+using Bluetooth::EmulatedRemote;
+using Bluetooth::GameCubePad;
+namespace RemoteButton = Bluetooth::RemoteButton;
+
+int g_failures = 0;
+
+#define CHECK(cond)                                                                    \
+    do {                                                                               \
+        if (!(cond)) {                                                                 \
+            std::fprintf(stderr, "%s:%d: CHECK failed: %s\n", __FILE__, __LINE__, #cond); \
+            ++g_failures;                                                              \
+        }                                                                              \
+    } while (0)
+
+uint64_t g_now = 1000000;
+
+Bytes Next(EmulatedRemote& remote) {
+    Bytes report;
+    if (!remote.PopInputReport(report, g_now)) {
+        return {};
+    }
+    return report;
+}
+
+void Send(EmulatedRemote& remote, const Bytes& report) {
+    remote.HandleOutputReport(report.data(), report.size());
+}
+
+// A remote that just connected has said what it has, and nothing is waiting.
+EmulatedRemote Connected() {
+    EmulatedRemote remote;
+    remote.Reset();
+    while (!Next(remote).empty()) {
+    }
+    return remote;
+}
+
+void TestAStatusReportSaysTheNunchukIsIn() {
+    EmulatedRemote remote = Connected();
+    Send(remote, {0x15, 0x00});
+    const Bytes status = Next(remote);
+    CHECK(status.size() == 7);
+    CHECK(status[0] == 0x20);
+    CHECK((status[3] & 0x02) != 0);  // extension connected
+}
+
+void TestTheModeDecidesTheReport() {
+    EmulatedRemote remote = Connected();
+    EmulatedInput input;
+    input.buttons = RemoteButton::kA | RemoteButton::kUp;
+    input.stickX = 1.0f;
+    input.z = true;
+    remote.SetInput(input);
+    Send(remote, {0x12, 0x04, 0x35});  // continuous, buttons + accelerometer + 16 extension bytes
+    const Bytes report = Next(remote);
+    CHECK(report.size() == 1 + 2 + 3 + 16);
+    CHECK(report[0] == 0x35);
+    CHECK(report[1] == 0x08);  // Up
+    CHECK(report[2] == 0x08);  // A
+    CHECK(report[6] == 0xE0);  // stick all the way right
+    CHECK(report[7] == 0x80);  // stick centred up and down
+    CHECK((report[11] & 0x01) == 0);  // Z held
+    CHECK((report[11] & 0x02) != 0);  // C not held
+}
+
+void TestAContinuousModeRepeatsAndAnOtherOneWaitsForAChange() {
+    EmulatedRemote remote = Connected();
+    Send(remote, {0x12, 0x04, 0x30});
+    CHECK(!Next(remote).empty());
+    CHECK(Next(remote).empty());  // too soon
+    g_now += 5000;
+    CHECK(!Next(remote).empty());
+
+    Send(remote, {0x12, 0x00, 0x30});
+    CHECK(!Next(remote).empty());  // the new mode reports once
+    g_now += 50000;
+    CHECK(Next(remote).empty());
+    EmulatedInput input;
+    input.buttons = RemoteButton::kB;
+    remote.SetInput(input);
+    CHECK(!Next(remote).empty());
+}
+
+void TestTheNunchukIsReadBack() {
+    EmulatedRemote remote = Connected();
+    // The game starts the extension without encryption, then reads its ID.
+    Send(remote, {0x16, 0x04, 0xA4, 0x00, 0xF0, 0x01, 0x55});
+    CHECK(Next(remote) == (Bytes{0x22, 0x00, 0x00, 0x16, 0x00}));
+    Send(remote, {0x16, 0x04, 0xA4, 0x00, 0xFB, 0x01, 0x00});
+    CHECK(Next(remote) == (Bytes{0x22, 0x00, 0x00, 0x16, 0x00}));
+    Send(remote, {0x17, 0x04, 0xA4, 0x00, 0xFA, 0x00, 0x06});
+    const Bytes id = Next(remote);
+    CHECK(id.size() == 22);
+    CHECK(id[0] == 0x21);
+    CHECK(id[3] == 0x50);  // six bytes, no error
+    CHECK(id[4] == 0x00 && id[5] == 0xFA);
+    CHECK((Bytes(id.begin() + 6, id.begin() + 12) == Bytes{0x00, 0x00, 0xA4, 0x20, 0x00, 0x00}));
+}
+
+void TestTheCalibrationChecksumsAdd() {
+    EmulatedRemote remote = Connected();
+    Send(remote, {0x17, 0x04, 0xA4, 0x00, 0x20, 0x00, 0x10});
+    const Bytes block = Next(remote);
+    uint8_t sum = 0x55;
+    for (int i = 0; i < 14; ++i) sum = static_cast<uint8_t>(sum + block[6 + i]);
+    CHECK(block[6 + 14] == sum);
+    CHECK(block[6 + 15] == static_cast<uint8_t>(sum + 0xAA));
+
+    Send(remote, {0x17, 0x00, 0x00, 0x00, 0x16, 0x00, 0x0A});  // the accelerometer's, in EEPROM
+    const Bytes accel = Next(remote);
+    sum = 0x55;
+    for (int i = 0; i < 9; ++i) sum = static_cast<uint8_t>(sum + accel[6 + i]);
+    CHECK(accel[6 + 9] == sum);
+}
+
+void TestALongReadComesSixteenBytesAtATime() {
+    EmulatedRemote remote = Connected();
+    Send(remote, {0x17, 0x00, 0x00, 0x00, 0x00, 0x00, 0x2A});
+    CHECK(Next(remote)[3] == 0xF0);
+    CHECK(Next(remote)[3] == 0xF0);
+    const Bytes last = Next(remote);
+    CHECK(last[3] == 0x90);  // ten bytes
+    CHECK(last[5] == 0x20);
+}
+
+void TestThePointerMovesTheSensorBarTheOtherWay() {
+    EmulatedRemote remote = Connected();
+    Send(remote, {0x13, 0x04});
+    Send(remote, {0x1A, 0x04});
+    Send(remote, {0x12, 0x04, 0x33});  // buttons + accelerometer + 12 IR bytes
+    EmulatedInput input;
+    input.pointerValid = true;
+    input.pointerX = 0.5f;
+    remote.SetInput(input);
+    const Bytes report = Next(remote);
+    CHECK(report.size() == 1 + 2 + 3 + 12);
+    const int x = report[6] | ((report[8] >> 4) & 3) << 8;
+    CHECK(x < 512 - 100);  // pointing right puts the left light left of centre
+
+    input.pointerValid = false;
+    remote.SetInput(input);
+    const Bytes off = Next(remote);
+    CHECK(off[6] == 0xFF && off[7] == 0xFF && off[8] == 0xFF);
+}
+
+void TestTheGameCubeLayout() {
+    GameCubePad pad;
+    pad.connected = true;
+    pad.buttons = 0x0100 | 0x0400 | 0x1000;  // A, X, Start
+    pad.stickY = 127;
+    pad.triggerR = 0xFF;
+    pad.substickX = -100;
+    const EmulatedInput input = Bluetooth::MapGameCubePad(pad);
+    CHECK(input.buttons == (RemoteButton::kA | RemoteButton::kOne | RemoteButton::kPlus | RemoteButton::kLeft));
+    CHECK(input.stickY == 1.0f);
+    CHECK(input.c && !input.z);
+
+    pad.buttons = 0x1000 | 0x0010;  // Start and Z
+    CHECK(Bluetooth::MapGameCubePad(pad).buttons == (RemoteButton::kHome | RemoteButton::kLeft));
+    pad.connected = false;
+    CHECK(Bluetooth::MapGameCubePad(pad).buttons == 0);
+}
+
+} // namespace
+
+int main() {
+    TestAStatusReportSaysTheNunchukIsIn();
+    TestTheModeDecidesTheReport();
+    TestAContinuousModeRepeatsAndAnOtherOneWaitsForAChange();
+    TestTheNunchukIsReadBack();
+    TestTheCalibrationChecksumsAdd();
+    TestALongReadComesSixteenBytesAtATime();
+    TestThePointerMovesTheSensorBarTheOtherWay();
+    TestTheGameCubeLayout();
+    if (g_failures != 0) {
+        std::fprintf(stderr, "%d check(s) failed\n", g_failures);
+        return 1;
+    }
+    std::printf("emulated remote: all checks passed\n");
+    return 0;
+}
