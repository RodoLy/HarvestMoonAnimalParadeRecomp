diff --git a/runtime/src/hle/animal_parade_loading.cpp b/runtime/src/hle/animal_parade_loading.cpp
new file mode 100644
index 0000000..7309500
--- /dev/null
+++ b/runtime/src/hle/animal_parade_loading.cpp
@@ -0,0 +1,95 @@
+// Fast loading for Harvest Moon: Animal Parade (RBIEE9): its fade to black.
+//
+// Between areas the game does not turn the picture off (VISetBlack, which fast loading already
+// covers): it fades the screen to black with one of its screen wipes, loads the next area behind the
+// black, shows the place sign (the building and its name) and fades back in. The player can do
+// nothing meanwhile. This probe tells vi.cpp when a wipe covers the whole screen in black, so all of
+// that runs at fast-loading speed (the sign is drawn on top of the black, so it is part of it).
+//
+// The wipes (BB_CWipe, bb_wipe.cpp; built by 0x80105948): the manager at 0x80502148 keeps 7 of them,
+// pointers at +0x18. In each wipe:
+//   +0x6C  how much of the screen it covers, a float from 0 (clear) to 1 (all of it)
+//   +0x78  its colour, R G B A bytes (0 0 0 255 for black)
+// A fade to black goes 0 -> 1 over about a second, stays at 1 while the area loads, and the fade back
+// in goes 1 -> 0.
+//
+// Speeding the game up is not enough on a slow computer: behind the black the game still draws the
+// whole 3D world every frame (well over a thousand draws), so each frame takes as long as in play and
+// the wait barely gets shorter. While the screen is covered, the layers that draw the 3D world are
+// therefore left out: nobody can see them, and the 2D layers on top (the fade itself and the place
+// sign) are still drawn. The game draws its frame in layers (0x8024C71C), one call to 0x80064520 per
+// layer:
+//   0x80064520 (layer in r3)  if layer+4 holds a list of things to draw, draws it and clears layer+4.
+// A layer that set the 3D world's projection the last time it was drawn (VI_HLE_WorldProjections)
+// counts as a 3D layer.
+
+#include "guest_abi/cpu_context.h"
+#include "guest_abi/guest_region.h"
+#include "guest_function_imports.h"
+#include "hle_stubs.h"
+#include "memory.h"
+#include "runtime_log.h"
+
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <map>
+
+namespace {
+
+constexpr uint32_t kWipeManager = 0x80502148u;
+constexpr int kWipes = 7;
+constexpr uint32_t kCoverage = 0x6C;
+constexpr uint32_t kColour = 0x78;
+
+bool AnimalParadeScreenCovered() {
+    static const bool running = GuestRegion::ForeignGameAddress("RBIEE9", 1u) != 0;
+    if (!running) {
+        return false;
+    }
+    for (int i = 0; i < kWipes; ++i) {
+        const uint32_t wipe = Memory::Read32(kWipeManager + 0x18 + 4 * i);
+        if (wipe == 0 || !Memory::Contains(wipe, kColour + 4)) {
+            continue;
+        }
+        const uint32_t bits = Memory::Read32(wipe + kCoverage);
+        float coverage;
+        std::memcpy(&coverage, &bits, sizeof(coverage));
+        const uint32_t colour = Memory::Read32(wipe + kColour);
+        if (coverage >= 0.999f && (colour & 0xFFFFFF00u) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+std::map<uint32_t, bool> g_worldLayers;  // each layer seen: did it draw the 3D world last time
+int g_layersLeftOut = 0;                 // for the log
+
+} // namespace
+
+// 0x80064520 (layer in r3): draws one layer of the frame.
+extern "C" void AnimalParadeDrawLayer(CpuContext* ctx) {
+    const uint32_t layer = ctx->gpr[3];
+    const bool hasList = Memory::Read32(layer + 4) != 0;
+    const auto known = g_worldLayers.find(layer);
+    if (hasList && known != g_worldLayers.end() && known->second && AnimalParadeScreenCovered()) {
+        Memory::Write32(layer + 4, 0);  // as the game does once the layer is drawn
+        if (g_layersLeftOut++ == 0) {
+            RT_LOG(RT_TAG_VI) << "fast loading: the 3D world is not drawn while the screen is black" << std::endl;
+        }
+        return;
+    }
+    const uint32_t before = VI_HLE_WorldProjections();
+    GuestFunctions::BaseTranslation(0x80064520u)(ctx);
+    if (hasList) {
+        g_worldLayers[layer] = VI_HLE_WorldProjections() != before;
+    }
+}
+FOREIGN_GAME_WRAPPER(RBIEE9, 80064520, AnimalParadeDrawLayer);
+
+namespace {
+
+const bool kRegistered = (VI_HLE_SetCoveredScreenProbe(&AnimalParadeScreenCovered), true);
+
+} // namespace
