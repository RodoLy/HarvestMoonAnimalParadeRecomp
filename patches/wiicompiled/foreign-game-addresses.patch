@@ -0,0 +1,18 @@
+#pragma once
+
+// What the hang watch (SystemBridge, foreign games only) looks at: the last guest CPU context that ran
+// and how many times the window has been updated. When the window stops being updated for a while,
+// the watch prints where the guest is from another thread, because the game's own thread is the one
+// that is stuck.
+
+#include <atomic>
+#include <cstdint>
+
+struct CpuContext;
+
+namespace HangWatch {
+
+inline std::atomic<CpuContext*> g_lastGuestCpuContext{nullptr};
+inline std::atomic<uint64_t> g_windowUpdates{0};
+
+} // namespace HangWatch
