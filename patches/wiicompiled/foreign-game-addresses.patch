+// True when the PC has a Qualcomm GPU (the Adreno of Snapdragon X laptops). Direct3D 12 on that GPU
+// shows the picture split down the middle and the character blinking out for a frame, while Vulkan
+// draws it correctly, so "auto" picks Vulkan there. dxgi.dll is loaded by hand so this adds no link.
+//
+// An x64 build running under emulation on a Windows ARM laptop can see the adapter with a different
+// vendor id, so the adapter name is checked as well, and so is the host processor: a Windows on ARM
+// PC is a Snapdragon machine.
+static bool IsWindowsOnArmHost() {
+    using IsWow64Process2Fn = BOOL(WINAPI*)(HANDLE, USHORT*, USHORT*);
+    HMODULE kernel = GetModuleHandleA("kernel32.dll");
+    const auto isWow64Process2 =
+        kernel != nullptr ? reinterpret_cast<IsWow64Process2Fn>(GetProcAddress(kernel, "IsWow64Process2")) : nullptr;
+    if (isWow64Process2 == nullptr) {
+        return false;
+    }
+    USHORT processMachine = 0;
+    USHORT nativeMachine = 0;
+    constexpr USHORT kMachineArm64 = 0xAA64;
+    return isWow64Process2(GetCurrentProcess(), &processMachine, &nativeMachine) && nativeMachine == kMachineArm64;
+}
+
+static bool HasQualcommGpu() {
+    using CreateFactory1Fn = HRESULT(WINAPI*)(REFIID, void**);
+    bool found = IsWindowsOnArmHost();
+    HMODULE dxgi = LoadLibraryA("dxgi.dll");
+    if (dxgi == nullptr) {
+        return found;
+    }
+    const auto createFactory = reinterpret_cast<CreateFactory1Fn>(GetProcAddress(dxgi, "CreateDXGIFactory1"));
+    IDXGIFactory1* factory = nullptr;
+    if (createFactory != nullptr && SUCCEEDED(createFactory(__uuidof(IDXGIFactory1), reinterpret_cast<void**>(&factory)))) {
+        constexpr UINT kQualcommVendorId = 0x5143;
+        IDXGIAdapter1* adapter = nullptr;
+        for (UINT index = 0; factory->EnumAdapters1(index, &adapter) != DXGI_ERROR_NOT_FOUND; ++index) {
+            DXGI_ADAPTER_DESC1 desc{};
+            if (SUCCEEDED(adapter->GetDesc1(&desc))) {
+                std::wstring name(desc.Description);
+                for (wchar_t& ch : name) {
+                    ch = static_cast<wchar_t>(towlower(ch));
+                }
+                const bool byName = name.find(L"adreno") != std::wstring::npos ||
+                                    name.find(L"qualcomm") != std::wstring::npos;
+                if (desc.VendorId == kQualcommVendorId || byName) {
+                    found = true;
+                }
+            }
+            adapter->Release();
+            adapter = nullptr;
+        }
+        factory->Release();
+    }
+    FreeLibrary(dxgi);
+    return found;
+}
