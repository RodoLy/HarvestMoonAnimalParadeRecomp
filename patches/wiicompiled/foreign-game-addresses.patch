+// A foreign game is still being brought up, and when it hangs, its own thread is the one that is stuck.
+// This thread notices when the window has not been updated for a while and prints where the guest is
+// (the registers and the stack's back chain), every few seconds while it stays that way, so the log
+// says where to look. Mario Kart Wii does not start it.
+std::string VI_HLE_DescribeState();
+
+void StartForeignGameHangWatch() {
+    if (!::GuestRegion::IsForeignGame()) {
+        return;
+    }
+    std::thread([] {
+        constexpr int kQuietSecondsBeforeReport = 5;
+        constexpr int kReports = 6;
+        // While the window keeps updating, a snapshot every so often still says where the game
+        // spends its time, for a game that runs but never shows anything.
+        constexpr int kSecondsBetweenSnapshots = 15;
+        constexpr int kSnapshots = 8;
+        uint64_t lastUpdates = HangWatch::g_windowUpdates.load(std::memory_order_relaxed);
+        int quietSeconds = 0;
+        int reports = 0;
+        int seconds = 0;
+        int snapshots = 0;
+        while (reports < kReports || snapshots < kSnapshots) {
+            std::this_thread::sleep_for(std::chrono::seconds(1));
+            ++seconds;
+            const uint64_t updates = HangWatch::g_windowUpdates.load(std::memory_order_relaxed);
+            if (updates != lastUpdates) {
+                if (snapshots < kSnapshots && seconds % kSecondsBetweenSnapshots == 0) {
+                    const CpuContext* cpu = HangWatch::g_lastGuestCpuContext.load(std::memory_order_relaxed);
+                    if (cpu != nullptr) {
+                        std::cerr << "[hang-watch] snapshot after " << seconds << " s ("
+                                  << updates << " window updates); VI: " << VI_HLE_DescribeState()
+                                  << "; the last guest context that ran:" << std::endl;
+                        SystemBridge::DumpCpuState(std::cerr, cpu);
+                        std::cerr.flush();
+                        ++snapshots;
+                    }
+                }
+                lastUpdates = updates;
+                quietSeconds = 0;
+                continue;
+            }
+            if (reports >= kReports) {
+                continue;
+            }
+            if (++quietSeconds % kQuietSecondsBeforeReport != 0) {
+                continue;
+            }
+            const CpuContext* cpu = HangWatch::g_lastGuestCpuContext.load(std::memory_order_relaxed);
+            if (cpu == nullptr) {
+                continue;
+            }
+            std::cerr << "[hang-watch] the window has not been updated for " << quietSeconds
+                      << " s; the last guest context that ran:" << std::endl;
+            SystemBridge::DumpCpuState(std::cerr, cpu);
+            std::cerr.flush();
+            ++reports;
+        }
+    }).detach();
+}
