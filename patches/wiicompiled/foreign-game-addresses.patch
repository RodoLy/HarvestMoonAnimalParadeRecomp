+constexpr BirthLines kBirthSetLines{Slot(6),  Slot(8),  Slot(9),  Slot(10), Slot(11),
+                                    Slot(12), Slot(13), Slot(17), Slot(15), Slot(16)};
+constexpr int kAddedSlot = 20;
+constexpr int kBirthSlotsAdded[10] = {6, 8, 9, 10, 11, 12, 13, 17, 15, 16};
+constexpr BirthLines kAddedBirthLines{Slot(20), Slot(21), Slot(22), Slot(23), Slot(24),
