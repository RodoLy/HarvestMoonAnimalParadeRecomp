+// ---------------------------------------------------------------------------------------------
+// Testing: an easy confession. With [mods] romance_any_gender_test_proposal = true (F10 > Mods) a
+// candidate's confession, the event whose messages are L000003a (GIL_L000003a for Gill), starts at
+// any hour of the day instead of only in the evening. It is a "panel" event: it starts when the
+// player steps on its spot by the lighthouse (param/field/info/fld_info04.pBin names the spot
+// L000003a), and that spot stays. The confession has to play for real: it is what makes the
+// candidate the player's sweetheart, and without it the proposal is turned down.
+//
+// The proposal (L000005) is left as in the original: giving the candidate a Blue Feather (item
+// 1269). Its scene starts with the player holding the feather out, and started any other way
+// (talking with empty hands, at bedtime, on leaving the house) the screen stayed black.
+
+// The candidates' confession events.
+std::set<long> ConfessionEvents(const std::filesystem::path& eventFolder) {
+    std::set<long> events;
+    static const std::regex confession("msg0_0\\s+\"[A-Z]+_L000003a\"");
+    for (const char* name : {"varSet_loveM.db", "varSet_loveW.db"}) {
+        for (const std::string& block : Blocks(ReadFile(eventFolder / name))) {
+            const long character = Number(block, "chara0");
+            if (character >= 0 && NaturalPartnerSex(static_cast<uint32_t>(character)) >= 0 &&
+                std::regex_search(block, confession)) {
+                events.insert(Number(block, "evtNo"));
+            }
+        }
+    }
+    return events;
+}
+
+// The confession's test trigger: its own spot by the lighthouse, at any hour of the day.
+std::string EasyConfessionTrigger(const std::string& block) {
+    static const std::regex start("timeS\\s+-?\\d+");
+    static const std::regex end("timeE\\s+-?\\d+");
+    return std::regex_replace(std::regex_replace(block, start, "timeS  6"), end, "timeE  22");
+}
