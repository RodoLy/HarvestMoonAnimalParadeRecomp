+
+// The camera shots, from the game's own scenes.
+constexpr Shot kBedtimeTwoShot{12.739f, 1.576f, 4.333f, 0.710f, 0.094f, 0.698f};  // LC_L000015: both, from the side
+constexpr Shot kWholeRoom{14.988f, 2.154f, 6.031f, 0.580f, 0.219f, 0.784f};      // GDSS_L000016: everyone
+// The Goddess from where the player stands (GDSS_L000016 leaves the player out of these shots).
+constexpr Shot kGoddessFace{15.535f, 1.687f, 3.770f, 0.991f, 0.127f, 0.048f};
+constexpr Shot kGoddessGoodbye{14.868f, 1.854f, 3.737f, 0.985f, 0.166f, 0.048f};
+constexpr Shot kCouple{12.221f, 1.697f, 4.933f, -0.716f, 0.219f, 0.663f};        // the couple, from her place
+
+// The two halves of the adoption, as in the game the question and, days later, the birth.
+enum class Part {
+    kQuestion,  // at bedtime the spouse asks for a child (plays as L000015 or L000029)
+    kGoddess,   // the Harvest Goddess brings the baby (plays as L000016 or L000030)
+    kPreview,   // both at once with nothing kept (see below)
+};
+
+// A scene of the adoption. `child` is 0 for the first child, 1 for the second; `playerIsMan` picks
+// the first child's "born" flag the way the birth scenes do (0x7DE after a wife's, 0x7DD after a
+// husband's; the second child's is 0x7EF either way).
+//
+// The question marks the spouse's question as done, which starts the game's own wait for the
+// birth; the Goddess's half then comes when the birth would.
+//
+// A preview (`previewCharacter`) is the question and the Goddess in one scene with that character
+// in the spouse's place and nothing the game keeps: no child, no flags, no hearts (only the name
+// typed goes on the first baby's record, which no one has yet and a real birth names again). It is
+// for trying the scene in any game (see kTestAdoptionKey in romance_any_gender.h).
+std::string BuildScene(Part part, int child, bool playerIsMan, const std::vector<Spouse>& spouses,
+                       uint32_t previewCharacter = 0) {
+    OpalScene scene;
+    Commands c{scene};
+    const bool preview = part == Part::kPreview;
+    const BirthLines& birth = preview ? kAddedBirthLines : kBirthSetLines;
+    const uint32_t partner = preview ? previewCharacter : kSpouse;
+    const uint32_t baby = child == 0 ? kFirstChild : kSecondChild;
+    const QuestionLines& lines = child == 0 ? kFirstQuestion : kSecondQuestion;
+
+    // Who is in it and the motions they use.
+    scene.Add(0x2C7, {0, Bits(1)});
+    c.Actor(kPlayer);
+    c.Actor(partner);
