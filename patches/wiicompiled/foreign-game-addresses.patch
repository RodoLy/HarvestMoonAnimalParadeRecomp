+// Harvest Moon: Animal Parade mod "romance_any_gender", part three: the lines of couples of the
+// same sex. (Part one is romance_any_gender.cpp, part two the adoption, romance_adoption.cpp.)
+//
+// The game picks a candidate's love lines by the player's sex: msglang/<language>/male/ or
+// female/love<Name>.mpc. In the original game a woman never courts Renee and a man never courts
+// Gill, so the female packs of the women candidates and the male packs of the men candidates were
+// never seen, and in some languages they still talk to the player, and of the couple, as the
+// original pairing would: "¡Bienvenido a casa!" to a woman, "Puedes besar a la novia" at the
+// wedding of two men, "Marido" among a wife's names for her wife, "Papá" as what the child of two
+// women calls the player. With the mod those packs are exactly what a couple of the same sex sees,
+// so the mod fixes those lines in its copies of the packs (romance_adoption.cpp writes the copies).
+//
+// Each fix is a piece of one message's text and what replaces it (every time it appears in that
+// message). A fix whose piece is not in the message is left out and logged, so another edition of
+// the disc only loses that fix. Covered: Spanish (spa), US English (eng) and British English
+// (bri); French, German and Italian are not.
+//
+// Lines about the children (who may be a boy or a girl) keep the original's words, as the original
+// does for every couple.
+
+#include "romance_any_gender.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace RomanceAnyGender {
+namespace {
+
+struct LineFix {
+    const char* language;  // the msglang folder
+    const char* pack;      // love<pack>.mpc
+    uint32_t message;
+    const char* from;
+    const char* to;
+};
+
+// The women candidates; the men candidates are the rest of the packs below.
+bool WomanCandidate(const std::string& pack) {
+    for (const char* name : {"Rena", "Katy", "Mai", "Selr", "Putt", "Ktmi", "Anis", "Lumi"}) {
+        if (pack == name) {
+            return true;
+        }
+    }
+    return false;
+}
