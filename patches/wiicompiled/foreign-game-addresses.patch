+// ---------------------------------------------------------------------------------------------
+// Writing a scene: OPAL bytecode.
+//
+// A command is the word 0x80000000 + its number, then its arguments. An argument after the word
+// 0x01000000 is an integer, after 0x02000000 a float, after 0x04000000 a yes/no; other arguments
+// are plain words (a character, a motion, a message, a float written as its bits). Jumps name a
+// command by its number. The file: "OPAL", the version 0x01040000, -1, then the offsets of the
+// command table, of the commands, their count and the offset of the debug section; the table has
+// each command's offset from the first; the debug section has, for each command, its number, a
+// 32-byte source name and a source line.
+
+class OpalScene {
+public:
+    using Words = std::vector<uint32_t>;
+
+    void Add(uint32_t command, const Words& arguments) {
+        Words words{0x80000000u | command};
+        words.insert(words.end(), arguments.begin(), arguments.end());
+        m_commands.push_back(std::move(words));
+    }
+
+    // A place to jump to: NewLabel(), jump to it, and Mark() it where it is.
+    int NewLabel() {
+        m_labels.push_back(-1);
+        return static_cast<int>(m_labels.size()) - 1;
+    }
+    void Mark(int label) { m_labels[label] = static_cast<int>(m_commands.size()); }
+
+    // A command whose argument `at` is a label's command number.
+    void AddJump(uint32_t command, Words arguments, size_t at, int label) {
+        m_fixes.push_back({m_commands.size(), at + 1, label});
+        Add(command, arguments);
+    }
+
+    std::string Build(const std::string& sourceName) const {
+        std::vector<Words> commands = m_commands;
+        for (const Fix& fix : m_fixes) {
+            commands[fix.command][fix.word] = static_cast<uint32_t>(m_labels[fix.label]);
+        }
+        const uint32_t count = static_cast<uint32_t>(commands.size());
+        const uint32_t table = 0x1C;
+        const uint32_t code = table + 4 * count;
+        uint32_t size = 0;
+        for (const Words& words : commands) {
+            size += 4 * static_cast<uint32_t>(words.size());
+        }
+        std::string out;
+        auto put = [&out](uint32_t value) {
+            out.push_back(static_cast<char>(value >> 24));
+            out.push_back(static_cast<char>(value >> 16));
+            out.push_back(static_cast<char>(value >> 8));
+            out.push_back(static_cast<char>(value));
+        };
+        out += "OPAL";
+        for (const uint32_t value : {0x01040000u, 0xFFFFFFFFu, table, code, count, code + size}) {
+            put(value);
+        }
+        uint32_t offset = 0;
+        for (const Words& words : commands) {
+            put(offset);
+            offset += 4 * static_cast<uint32_t>(words.size());
+        }
+        for (const Words& words : commands) {
+            for (const uint32_t word : words) {
+                put(word);
+            }
+        }
+        for (uint32_t i = 0; i < count; ++i) {
+            put(i);
+            std::string name = sourceName.substr(0, 31);
+            name.resize(32, '\0');
+            out += name;
+            put(i + 1);
+        }
+        return out;
+    }
+
+private:
+    struct Fix {
+        size_t command;
+        size_t word;
+        int label;
+    };
+    std::vector<Words> m_commands;
+    std::vector<int> m_labels;
+    std::vector<Fix> m_fixes;
+};
+
+uint32_t Bits(float value) {
+    uint32_t bits;
+    std::memcpy(&bits, &value, 4);
+    return bits;
+}
+
+// Typed arguments.
+OpalScene::Words Int(int32_t value) { return {0x01000000u, static_cast<uint32_t>(value)}; }
+OpalScene::Words Float(float value) { return {0x02000000u, Bits(value)}; }
+OpalScene::Words Yes() { return {0x04000000u, 1u}; }
+
+OpalScene::Words operator+(OpalScene::Words a, const OpalScene::Words& b) {
+    a.insert(a.end(), b.begin(), b.end());
+    return a;
+}
+
+
+// Message n of the event's message set.
+constexpr uint32_t Slot(int n) { return 0xFFFFFEC0u + static_cast<uint32_t>(n); }
+
+// A camera shot: where the camera is, then the way back from what it looks at.
+struct Shot {
+    float x, y, z, dx, dy, dz;
+};
+
+// The commands, by what the game's scenes use them for.
+struct Commands {
+    OpalScene& scene;
+
+    void Actor(uint32_t who) { scene.Add(0x082, {who}); }
+    void LetGo(uint32_t who) { scene.Add(0x083, {who}); }
+    void LoadMotion(uint32_t who, uint32_t motion) { scene.Add(0x08F, {who, motion}); }
+    void Place(uint32_t who, float x, float z) { scene.Add(0x086, OpalScene::Words{who} + Float(x) + Float(z)); }
+    void Turn(uint32_t who, float angle) {  // 90 faces -x, 270 faces +x
+        scene.Add(0x091, OpalScene::Words{who} + Float(0) + Float(angle) + Float(0));
+    }
+    // A motion: once (loop 0) or looping (1), then `next`, with blend times (-1: the motion's own).
+    void Motion(uint32_t who, uint32_t motion, uint32_t loop = 1, uint32_t next = 0, float in = -1, float out = -1) {
+        scene.Add(0x08B, {who, motion, loop, next, Bits(in), Bits(out)});
+    }
+    void WaitForMotion(uint32_t who) { scene.Add(0x08D, {who}); }
+    void Face(uint32_t who, uint32_t expression) { scene.Add(0x095, {who, expression}); }
+    void Appear(uint32_t who, float seconds) { scene.Add(0x09A, {who, Bits(seconds)}); }
+    void Vanish(uint32_t who, float seconds) { scene.Add(0x09B, {who, Bits(seconds)}); }
+    // Shown or left out of the shot at once (the game's scenes leave out whoever would stand
+    // between the camera and the one who talks).
+    void Show(uint32_t who) { scene.Add(0x084, {who}); }
+    void Hide(uint32_t who) { scene.Add(0x085, {who}); }
+    void Hold(uint32_t child, uint32_t by) { scene.Add(0x26B, {child, by, 0x32}); }
+    void Wait(float seconds) { scene.Add(0x022, Float(seconds)); }
+    void Camera(const Shot& shot) {
+        scene.Add(0x0C2, Float(shot.x) + Float(shot.y) + Float(shot.z));
+        scene.Add(0x0C3, Float(shot.dx) + Float(shot.dy) + Float(shot.dz));
+    }
+    void Talkers(uint32_t first, uint32_t second) {
+        scene.Add(0x28A, Int(0) + OpalScene::Words{first, 0xFFFFFFFFu});
+        scene.Add(0x28A, Int(1) + OpalScene::Words{second, 0xFFFFFFFFu});
+    }
+    void FadeIn(float seconds) { scene.Add(0x0E2, {Bits(seconds), 0}); }
+    void FadeOut(float seconds) { scene.Add(0x0E3, {Bits(seconds), 0}); }
+    void Sparkle() {  // the Harvest Goddess's sound and light
+        scene.Add(0x28D, Int(1) + OpalScene::Words{0x33F, 1, 0xFFFFFFFFu} + Float(0) + Float(0) + Float(0));
+        scene.Add(0x2A4, {0x27D});
+    }
+    void Say(uint32_t message, uint32_t who) { scene.Add(0x0A5, {message, who, 0, 0, 1, 0}); }
+    void Notice(uint32_t message) { scene.Add(0x0A4, {message}); }
+    // A question with choices; the answer (0, 1, 2...) goes to register `answer`.
+    void Choose(uint32_t question, uint32_t choices, uint32_t answer) {
+        scene.Add(0x0A7, OpalScene::Words{question, choices, answer} + Float(-1));
+    }
+    void Goto(int label) { scene.AddJump(0x000, {0}, 0, label); }
+    // If register `reg` holds `value` go on at `yes`, otherwise at `no`.
+    void IfRegister(uint32_t reg, int32_t value, int yes, int no) {
+        scene.Add(0x008, OpalScene::Words{0, reg} + Int(value));
+        scene.AddJump(0x00B, {0}, 0, yes);
+        scene.AddJump(0x00C, {0}, 0, no);
+    }
+    // After StartSpouseTest(): if the spouse is `character` go on at `yes`, otherwise at `no`.
+    void StartSpouseTest() { scene.Add(0x347, {0, kSpouse}); }
+    void IfSpouseIs(uint32_t character, int yes, int no) {
+        scene.Add(0x347, {1, character});
+        scene.Add(0x008, OpalScene::Words{0, 0} + Yes());
+        scene.AddJump(0x00B, {0}, 0, yes);
+        scene.AddJump(0x00C, {0}, 0, no);
+    }
+    void SetFlag(uint32_t flag) { scene.Add(0x102, OpalScene::Words{flag} + Int(1)); }
+    void ChildSex(uint32_t child, int32_t sex) { scene.Add(0x382, OpalScene::Words{child, 0} + Int(sex)); }
+};
+
+// The Goddess's lines (new messages in every love pack; see kGoddessLines below).
+constexpr uint32_t kDoNotBeAfraid = 0xE000;
+constexpr uint32_t kIHaveSeenYourLove = 0xE001;
+constexpr uint32_t kIEntrustThisBaby = 0xE002;
+constexpr uint32_t kNameTheBaby = 0xE003;
+constexpr uint32_t kLoveThem = 0xE004;
+constexpr uint32_t kWeMeetAgain = 0xE005;
+constexpr uint32_t kLetUsAskTheGoddess = 0xE006;
+constexpr uint32_t kLetUsAskAgain = 0xE007;
+constexpr uint32_t kLookItIsTheGoddess = 0xE008;
+
+// The spouse's lines from the birth's message set (L000016 and L000030 share it) that the end of
+// the scene uses. The Goddess's scene plays as the birth event and has them in their own slots;
