diff --git a/runtime/src/hle/gx/gx_frame_trace.cpp b/runtime/src/hle/gx/gx_frame_trace.cpp
new file mode 100644
index 0000000..4e3e352
--- /dev/null
+++ b/runtime/src/hle/gx/gx_frame_trace.cpp
@@ -0,0 +1,67 @@
+#include "gx_frame_trace.h"
+
+#include "runtime_log.h"
+
+#include <atomic>
+#include <cstdarg>
+#include <cstdio>
+
+namespace GxFrameTrace {
+namespace {
+std::atomic<int> g_framesLeft{0};
+std::atomic<int> g_frame{0};
+std::atomic<int> g_line{0};
+std::atomic<int> g_session{0};
+// A frame of a busy scene can bind thousands of textures; past this many lines the rest of the
+// frame is only counted, so the log stays readable.
+constexpr int kLinesPerFrame = 40000;
+} // namespace
+
+void Request(int frames) {
+    g_session.fetch_add(1);
+    g_frame.store(0);
+    g_line.store(0);
+    g_framesLeft.store(frames);
+    RT_LOGF(RT_TAG_GX, "[gx-trace] tracing the next %d frames\n", frames);
+}
+
+bool Active() { return g_framesLeft.load(std::memory_order_relaxed) > 0; }
+
+int Frame() { return g_frame.load(); }
+
+int Session() { return g_session.load(); }
+
+void Note(const char* format, ...) {
+    if (!Active()) {
+        return;
+    }
+    const int line = g_line.fetch_add(1);
+    if (line > kLinesPerFrame) {
+        return;
+    }
+    char text[512];
+    va_list args;
+    va_start(args, format);
+    std::vsnprintf(text, sizeof(text), format, args);
+    va_end(args);
+    if (line == kLinesPerFrame) {
+        RT_LOGF(RT_TAG_GX, "[gx-trace] frame %d: more than %d lines, the rest is left out\n", g_frame.load(),
+                kLinesPerFrame);
+        return;
+    }
+    RT_LOGF(RT_TAG_GX, "[gx-trace] frame %d: %s\n", g_frame.load(), text);
+}
+
+void EndFrame() {
+    if (!Active()) {
+        return;
+    }
+    RT_LOGF(RT_TAG_GX, "[gx-trace] frame %d ends (%d lines)\n", g_frame.load(), g_line.load());
+    g_frame.fetch_add(1);
+    g_line.store(0);
+    if (g_framesLeft.fetch_sub(1) == 1) {
+        RT_LOGF(RT_TAG_GX, "[gx-trace] done\n");
+    }
+}
+
+} // namespace GxFrameTrace
diff --git a/runtime/src/hle/gx/gx_frame_trace.h b/runtime/src/hle/gx/gx_frame_trace.h
new file mode 100644
index 0000000..0e6166a
--- /dev/null
+++ b/runtime/src/hle/gx/gx_frame_trace.h
@@ -0,0 +1,30 @@
+#pragma once
+
+// A short record of how the game builds a few frames: every EFB copy (to a texture or to the screen),
+// every texture it binds and every blend mode it sets, in order. Press F9 while a frame looks wrong and
+// the next frames go to the log with an "[gx-trace]" prefix. A game that draws its picture in several
+// passes (depth of field, bloom, a blurred copy) shows here which copy it reads back and when, which is
+// what a frame that flickers or comes out grey needs to be understood.
+
+#include <cstdint>
+
+namespace GxFrameTrace {
+
+// Trace the next `frames` frames (F9 asks for three).
+void Request(int frames);
+// True while a traced frame is being drawn.
+bool Active();
+// One line of the trace, printf style.
+void Note(const char* format, ...)
+#if defined(__GNUC__) || defined(__clang__)
+    __attribute__((format(printf, 1, 2)))
+#endif
+    ;
+// Which traced frame is being drawn (0 for the first one).
+int Frame();
+// Counts the F9 presses, so something done once per trace can tell a new trace from the one before.
+int Session();
+// GXCopyDisp ends a frame.
+void EndFrame();
+
+} // namespace GxFrameTrace
