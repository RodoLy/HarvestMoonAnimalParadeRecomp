+// The emulated Wii Remote's protocol (emulated_remote.h). The report layouts are the remote's own:
+// every input report starts with the two core button bytes, then carries the accelerometer, the IR
+// camera's dots and the extension's bytes in the mix the reporting mode asks for.
+
+#include "bluetooth/emulated_remote.h"
+
+#include "wiimote_ext_crypto.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+namespace Bluetooth {
+namespace {
+
+// Output reports (game -> remote).
+constexpr uint8_t kRumble = 0x10;
+constexpr uint8_t kLeds = 0x11;
+constexpr uint8_t kReportingMode = 0x12;
+constexpr uint8_t kIrClock = 0x13;
+constexpr uint8_t kSpeakerEnable = 0x14;
+constexpr uint8_t kStatusRequest = 0x15;
+constexpr uint8_t kWriteMemory = 0x16;
+constexpr uint8_t kReadMemory = 0x17;
+constexpr uint8_t kSpeakerData = 0x18;
+constexpr uint8_t kSpeakerMute = 0x19;
+constexpr uint8_t kIrCamera = 0x1A;
+
+// Input reports (remote -> game).
+constexpr uint8_t kStatus = 0x20;
+constexpr uint8_t kReadData = 0x21;
+constexpr uint8_t kAcknowledge = 0x22;
+
+// Flags in the first byte of most output reports.
+constexpr uint8_t kAcknowledgeWanted = 0x02;
+constexpr uint8_t kEnable = 0x04;
+
+// The address spaces of memory reads and writes.
+constexpr uint8_t kRegisterSpace = 0x04;
+constexpr uint32_t kExtensionRegisters = 0xA40000;
+constexpr uint32_t kCameraRegisters = 0xB00000;
+
+constexpr uint8_t kErrorNone = 0x00;
+constexpr uint8_t kErrorBadAddress = 0x08;
+
+constexpr uint64_t kContinuousIntervalUs = 5000;
+
+// The accelerometers' calibration: 0x80 at rest on every axis and 0x9A (remote) or 0xB3 (Nunchuk)
+// with 1 g on it. Held pointing at the screen, gravity is on Z.
+constexpr uint8_t kAccelZero = 0x80;
+constexpr uint8_t kRemoteOneG = 0x9A;
+constexpr uint8_t kNunchukOneG = 0xB3;
+
+// The Nunchuk's stick: 0x80 in the middle, 0x20..0xE0 at the edges.
+constexpr uint8_t kStickCenter = 0x80;
+constexpr float kStickReach = 0x60;
+
+// The IR camera sees the sensor bar's two lights 1024 x 768. Pointing right moves them left, pointing
+// down moves them up.
+constexpr int kCameraCenterX = 512;
+constexpr int kCameraCenterY = 384;
+constexpr float kCameraReachX = 400.0f;
+constexpr float kCameraReachY = 300.0f;
+constexpr int kDotHalfDistance = 100;
+constexpr uint8_t kDotSize = 3;
+
+constexpr std::array<uint8_t, 6> kNunchukId = {0x00, 0x00, 0xA4, 0x20, 0x00, 0x00};
+
+// Calibration blocks end in two checksums: the sum of the rest plus 0x55, then that plus 0xAA.
+template <size_t N>
+void PutCalibration(uint8_t* dst, const std::array<uint8_t, N>& values, bool secondChecksum) {
+    uint8_t sum = 0x55;
+    for (size_t i = 0; i < N; ++i) {
+        dst[i] = values[i];
+        sum = static_cast<uint8_t>(sum + values[i]);
+    }
+    dst[N] = sum;
+    if (secondChecksum) {
+        dst[N + 1] = static_cast<uint8_t>(sum + 0xAA);
+    }
+}
+
+int ClampCamera(int value, int maximum) {
+    return std::clamp(value, 0, maximum);
+}
+
+} // namespace
+
+EmulatedInput MapGameCubePad(const GameCubePad& pad) {
+    // PAD_* bits of dolphin/pad.h.
+    constexpr uint16_t kPadLeft = 0x0001, kPadRight = 0x0002, kPadDown = 0x0004, kPadUp = 0x0008;
+    constexpr uint16_t kPadZ = 0x0010, kPadR = 0x0020, kPadL = 0x0040;
+    constexpr uint16_t kPadA = 0x0100, kPadB = 0x0200, kPadX = 0x0400, kPadY = 0x0800;
+    constexpr uint16_t kPadStart = 0x1000;
+    constexpr int kSubstickThreshold = 40;
+    constexpr uint8_t kTriggerThreshold = 0x60;
+
+    EmulatedInput input;
+    if (!pad.connected) {
+        return input;
+    }
+    const uint16_t b = pad.buttons;
+    auto set = [&](bool held, uint16_t button) {
+        if (held) input.buttons |= button;
+    };
+    set((b & kPadA) != 0, RemoteButton::kA);
+    set((b & kPadB) != 0, RemoteButton::kB);
+    set((b & kPadX) != 0, RemoteButton::kOne);
+    set((b & kPadY) != 0, RemoteButton::kTwo);
+    const bool start = (b & kPadStart) != 0;
+    const bool z = (b & kPadZ) != 0;
+    if (start && z) {
+        input.buttons |= RemoteButton::kHome;
+    } else {
+        set(start, RemoteButton::kPlus);
+        set(z, RemoteButton::kMinus);
+    }
+    set((b & kPadLeft) != 0 || pad.substickX < -kSubstickThreshold, RemoteButton::kLeft);
+    set((b & kPadRight) != 0 || pad.substickX > kSubstickThreshold, RemoteButton::kRight);
+    set((b & kPadDown) != 0 || pad.substickY < -kSubstickThreshold, RemoteButton::kDown);
+    set((b & kPadUp) != 0 || pad.substickY > kSubstickThreshold, RemoteButton::kUp);
+
+    input.stickX = std::clamp(pad.stickX / 127.0f, -1.0f, 1.0f);
+    input.stickY = std::clamp(pad.stickY / 127.0f, -1.0f, 1.0f);
+    input.z = (b & kPadL) != 0 || pad.triggerL >= kTriggerThreshold;
+    input.c = (b & kPadR) != 0 || pad.triggerR >= kTriggerThreshold;
+    return input;
+}
+
+EmulatedRemote::EmulatedRemote() {
+    // EEPROM: the IR camera's calibration at 0x00 and the accelerometer's at 0x16, each twice.
+    const std::array<uint8_t, 10> ir = {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
+    PutCalibration(&m_eeprom[0x00], ir, false);
+    PutCalibration(&m_eeprom[0x0B], ir, false);
+    const std::array<uint8_t, 9> accel = {kAccelZero, kAccelZero, kAccelZero, 0x00,
+                                          kRemoteOneG, kRemoteOneG, kRemoteOneG, 0x00, 0x40};
+    PutCalibration(&m_eeprom[0x16], accel, false);
+    PutCalibration(&m_eeprom[0x20], accel, false);
+    Reset();
+}
+
+void EmulatedRemote::Reset() {
+    m_answers.clear();
+    m_lastReport.clear();
+    m_lastReportUs = 0;
+    m_reportPending = false;
+    m_leds = 0;
+    m_mode = 0x30;
+    m_continuous = false;
+    m_irClock = false;
+    m_irCamera = false;
+    m_speaker = false;
+    m_camera.fill(0);
+
+    // The Nunchuk's registers: its calibration at 0x20 (and 0x30), its ID at 0xFA.
+    m_extension.fill(0);
+    const std::array<uint8_t, 14> nunchuk = {kAccelZero, kAccelZero, kAccelZero, 0x00,
+                                             kNunchukOneG, kNunchukOneG, kNunchukOneG, 0x00,
+                                             0xE0, 0x20, kStickCenter, 0xE0, 0x20, kStickCenter};
+    PutCalibration(&m_extension[0x20], nunchuk, true);
+    PutCalibration(&m_extension[0x30], nunchuk, true);
+    std::copy(kNunchukId.begin(), kNunchukId.end(), m_extension.begin() + 0xFA);
+
+    // A remote that just connected tells the game what it has, the Nunchuk among it.
+    QueueStatus();
+}
+
+void EmulatedRemote::SetInput(const EmulatedInput& input) {
+    m_input = input;
+}
+
+void EmulatedRemote::HandleOutputReport(const uint8_t* report, size_t size) {
+    if (size < 2) {
+        return;
+    }
+    const uint8_t id = report[0];
+    const uint8_t flags = report[1];
+    const bool acknowledge = (flags & kAcknowledgeWanted) != 0;
+    switch (id) {
+    case kRumble:
+        break;
+    case kLeds:
+        m_leds = flags >> 4;
+        if (acknowledge) QueueAcknowledge(id, kErrorNone);
+        break;
+    case kReportingMode:
+        if (size >= 3) {
+            m_continuous = (flags & kEnable) != 0;
+            m_mode = report[2];
+            m_reportPending = true;
+        }
+        if (acknowledge) QueueAcknowledge(id, kErrorNone);
+        break;
+    case kIrClock:
+        m_irClock = (flags & kEnable) != 0;
+        if (acknowledge) QueueAcknowledge(id, kErrorNone);
+        break;
+    case kIrCamera:
+        m_irCamera = (flags & kEnable) != 0;
+        if (acknowledge) QueueAcknowledge(id, kErrorNone);
+        break;
+    case kSpeakerEnable:
+        m_speaker = (flags & kEnable) != 0;
+        if (acknowledge) QueueAcknowledge(id, kErrorNone);
+        break;
+    case kSpeakerMute:
+        if (acknowledge) QueueAcknowledge(id, kErrorNone);
+        break;
+    case kStatusRequest:
+        QueueStatus();
+        break;
+    case kWriteMemory:
+        WriteMemory(report + 1, size - 1);
+        break;
+    case kReadMemory:
+        ReadMemory(report + 1, size - 1);
+        break;
+    case kSpeakerData:
+        break;
+    default:
+        break;
+    }
+}
+
+void EmulatedRemote::QueueAcknowledge(uint8_t reportId, uint8_t error) {
+    std::vector<uint8_t> out = {kAcknowledge};
+    AppendButtons(out);
+    out.push_back(reportId);
+    out.push_back(error);
+    m_answers.push_back(std::move(out));
+}
+
+void EmulatedRemote::QueueStatus() {
+    std::vector<uint8_t> out = {kStatus};
+    AppendButtons(out);
+    constexpr uint8_t kExtensionConnected = 0x02;
+    constexpr uint8_t kSpeakerOn = 0x04;
+    constexpr uint8_t kIrOn = 0x08;
+    uint8_t status = static_cast<uint8_t>(m_leds << 4) | kExtensionConnected;
+    if (m_speaker) status |= kSpeakerOn;
+    if (m_irCamera) status |= kIrOn;
+    out.push_back(status);
+    out.push_back(0x00);
+    out.push_back(0x00);
+    out.push_back(0xC0);  // battery: plenty
+    m_answers.push_back(std::move(out));
+    // The remote stops reporting after a status report until the game sets the mode again; a
+    // continuous mode resumes at once.
+    m_reportPending = true;
+}
+
+void EmulatedRemote::WriteMemory(const uint8_t* payload, size_t size) {
+    // space, address (3 bytes), length, 16 bytes of data
+    if (size < 6) {
+        QueueAcknowledge(kWriteMemory, kErrorBadAddress);
+        return;
+    }
+    const bool registers = (payload[0] & kRegisterSpace) != 0;
+    const uint32_t address = (uint32_t{payload[1]} << 16) | (uint32_t{payload[2]} << 8) | payload[3];
+    const size_t length = std::min<size_t>({payload[4], 16, size - 5});
+    const uint8_t* data = payload + 5;
+
+    uint8_t error = kErrorNone;
+    if (!registers) {
+        if (address + length <= m_eeprom.size()) {
+            std::memcpy(&m_eeprom[address], data, length);
+        } else {
+            error = kErrorBadAddress;
+        }
+    } else if ((address & 0xFF0000) == kExtensionRegisters) {
+        const uint32_t offset = address & 0xFF;
+        for (size_t i = 0; i < length && offset + i < m_extension.size(); ++i) {
+            m_extension[offset + i] = data[i];
+        }
+    } else if ((address & 0xFF0000) == kCameraRegisters) {
+        const uint32_t offset = address & 0xFF;
+        for (size_t i = 0; i < length && offset + i < m_camera.size(); ++i) {
+            m_camera[offset + i] = data[i];
+        }
+    } else {
+        // The speaker's registers (0xA2xxxx) and anything else: taken, kept nowhere.
+    }
+    QueueAcknowledge(kWriteMemory, error);
+}
+
+void EmulatedRemote::ReadMemory(const uint8_t* payload, size_t size) {
+    // space, address (3 bytes), length (2 bytes)
+    if (size < 6) {
+        return;
+    }
+    const bool registers = (payload[0] & kRegisterSpace) != 0;
+    const uint32_t address = (uint32_t{payload[1]} << 16) | (uint32_t{payload[2]} << 8) | payload[3];
+    const uint32_t length = (uint32_t{payload[4]} << 8) | payload[5];
+
+    std::vector<uint8_t> data(length, 0);
+    bool valid = true;
+    if (!registers) {
+        valid = address + length <= m_eeprom.size();
+        if (valid) std::memcpy(data.data(), &m_eeprom[address], length);
+    } else if ((address & 0xFF0000) == kExtensionRegisters) {
+        const uint32_t offset = address & 0xFF;
+        for (uint32_t i = 0; i < length; ++i) {
+            data[i] = offset + i < m_extension.size() ? m_extension[offset + i] : 0;
+        }
+        if (ExtensionEncrypted()) {
+            std::array<uint8_t, 16> key{};
+            std::copy(m_extension.begin() + 0x40, m_extension.begin() + 0x50, key.begin());
+            if (const auto tables = Wiimote::ExtCrypto::FromKey(key)) {
+                tables->Encrypt(data.data(), offset, data.size());
+            }
+        }
+    } else if ((address & 0xFF0000) == kCameraRegisters) {
+        const uint32_t offset = address & 0xFF;
+        for (uint32_t i = 0; i < length; ++i) {
+            data[i] = offset + i < m_camera.size() ? m_camera[offset + i] : 0;
+        }
+    } else {
+        valid = false;
+    }
+
+    if (!valid) {
+        std::vector<uint8_t> out = {kReadData};
+        AppendButtons(out);
+        out.push_back(0xF0 | kErrorBadAddress);
+        out.push_back(static_cast<uint8_t>(address >> 8));
+        out.push_back(static_cast<uint8_t>(address));
+        out.resize(out.size() + 16, 0);
+        m_answers.push_back(std::move(out));
+        return;
+    }
+    // The answer comes 16 bytes at a time, each with the low 16 bits of its address.
+    for (uint32_t done = 0; done < length || done == 0; done += 16) {
+        const uint32_t chunk = std::min<uint32_t>(16, length - done);
+        const uint32_t at = address + done;
+        std::vector<uint8_t> out = {kReadData};
+        AppendButtons(out);
+        out.push_back(static_cast<uint8_t>(((chunk == 0 ? 0 : chunk - 1) << 4) | kErrorNone));
+        out.push_back(static_cast<uint8_t>(at >> 8));
+        out.push_back(static_cast<uint8_t>(at));
+        for (uint32_t i = 0; i < 16; ++i) {
+            out.push_back(i < chunk ? data[done + i] : 0);
+        }
+        m_answers.push_back(std::move(out));
+        if (chunk == 0) break;
+    }
+}
+
+bool EmulatedRemote::ExtensionEncrypted() const {
+    // Writing 0x55 to 0xA400F0 starts the Nunchuk without encryption; the older 0xAA start encrypts
+    // with the key the game wrote to 0xA40040..0x4F.
+    return m_extension[0xF0] == 0xAA;
+}
+
+bool EmulatedRemote::PopInputReport(std::vector<uint8_t>& report, uint64_t nowUs) {
+    if (!m_answers.empty()) {
+        report = std::move(m_answers.front());
+        m_answers.pop_front();
+        return true;
+    }
+    std::vector<uint8_t> next = InputReport();
+    if (next.empty()) {
+        return false;
+    }
+    const bool changed = next != m_lastReport;
+    const bool due = m_continuous && nowUs - m_lastReportUs >= kContinuousIntervalUs;
+    if (!changed && !due && !m_reportPending) {
+        return false;
+    }
+    m_reportPending = false;
+    m_lastReport = next;
+    m_lastReportUs = nowUs;
+    report = std::move(next);
+    return true;
+}
+
+std::vector<uint8_t> EmulatedRemote::InputReport() const {
+    std::vector<uint8_t> out = {m_mode};
+    switch (m_mode) {
+    case 0x30:
+        AppendButtons(out);
+        break;
+    case 0x31:
+        AppendButtons(out);
+        AppendAccelerometer(out);
+        break;
+    case 0x32:
+        AppendButtons(out);
+        AppendExtension(out, 8);
+        break;
+    case 0x33:
+        AppendButtons(out);
+        AppendAccelerometer(out);
+        AppendIr(out, 12);
+        break;
+    case 0x34:
+        AppendButtons(out);
+        AppendExtension(out, 19);
+        break;
+    case 0x35:
+        AppendButtons(out);
+        AppendAccelerometer(out);
+        AppendExtension(out, 16);
+        break;
+    case 0x36:
+        AppendButtons(out);
+        AppendIr(out, 10);
+        AppendExtension(out, 9);
+        break;
+    case 0x37:
+        AppendButtons(out);
+        AppendAccelerometer(out);
+        AppendIr(out, 10);
+        AppendExtension(out, 6);
+        break;
+    case 0x3D:
+        AppendExtension(out, 21);
+        break;
+    default:
+        // 0x3E/0x3F (full IR, interleaved) are not offered; the buttons still get through.
+        out[0] = 0x30;
+        AppendButtons(out);
+        break;
+    }
+    return out;
+}
+
+void EmulatedRemote::AppendButtons(std::vector<uint8_t>& out) const {
+    out.push_back(static_cast<uint8_t>(m_input.buttons >> 8));
+    out.push_back(static_cast<uint8_t>(m_input.buttons));
+}
+
+void EmulatedRemote::AppendAccelerometer(std::vector<uint8_t>& out) const {
+    // Held still, pointing at the screen: 1 g on Z. The low bits in the button bytes stay 0.
+    out.push_back(kAccelZero);
+    out.push_back(kAccelZero);
+    out.push_back(kRemoteOneG);
+}
+
+void EmulatedRemote::AppendIr(std::vector<uint8_t>& out, size_t bytes) const {
+    const bool on = m_irClock && m_irCamera && m_input.pointerValid;
+    struct Dot {
+        int x;
+        int y;
+    };
+    std::array<std::optional<Dot>, 4> dots{};
+    if (on) {
+        const int centerX = kCameraCenterX - static_cast<int>(std::lround(m_input.pointerX * kCameraReachX));
+        const int centerY = kCameraCenterY - static_cast<int>(std::lround(m_input.pointerY * kCameraReachY));
+        dots[0] = Dot{ClampCamera(centerX - kDotHalfDistance, 1023), ClampCamera(centerY, 767)};
+        dots[1] = Dot{ClampCamera(centerX + kDotHalfDistance, 1023), ClampCamera(centerY, 767)};
+    }
+    if (bytes == 12) {
+        // Extended: three bytes a dot, with its size.
+        for (const auto& dot : dots) {
+            if (!dot) {
+                out.insert(out.end(), {0xFF, 0xFF, 0xFF});
+                continue;
+            }
+            out.push_back(static_cast<uint8_t>(dot->x));
+            out.push_back(static_cast<uint8_t>(dot->y));
+            out.push_back(static_cast<uint8_t>(((dot->y >> 8) & 3) << 6 | ((dot->x >> 8) & 3) << 4 | kDotSize));
+        }
+        return;
+    }
+    // Basic: two dots in five bytes, twice.
+    for (size_t pair = 0; pair < 2; ++pair) {
+        const auto& a = dots[pair * 2];
+        const auto& b = dots[pair * 2 + 1];
+        const int ax = a ? a->x : 0x3FF, ay = a ? a->y : 0x3FF;
+        const int bx = b ? b->x : 0x3FF, by = b ? b->y : 0x3FF;
+        out.push_back(static_cast<uint8_t>(ax));
+        out.push_back(static_cast<uint8_t>(ay));
+        out.push_back(static_cast<uint8_t>(((ay >> 8) & 3) << 6 | ((ax >> 8) & 3) << 4 | ((by >> 8) & 3) << 2 |
+                                           ((bx >> 8) & 3)));
+        out.push_back(static_cast<uint8_t>(bx));
+        out.push_back(static_cast<uint8_t>(by));
+    }
+}
+
+void EmulatedRemote::AppendExtension(std::vector<uint8_t>& out, size_t bytes) const {
+    // The Nunchuk's six bytes: stick X and Y, accelerometer X, Y, Z, then C and Z (0 when held).
+    std::array<uint8_t, 6> nunchuk = {
+        static_cast<uint8_t>(std::lround(kStickCenter + m_input.stickX * kStickReach)),
+        static_cast<uint8_t>(std::lround(kStickCenter + m_input.stickY * kStickReach)),
+        kAccelZero,
+        kAccelZero,
+        kNunchukOneG,
+        static_cast<uint8_t>((m_input.c ? 0x00 : 0x02) | (m_input.z ? 0x00 : 0x01)),
+    };
+    if (ExtensionEncrypted()) {
+        std::array<uint8_t, 16> key{};
+        std::copy(m_extension.begin() + 0x40, m_extension.begin() + 0x50, key.begin());
+        if (const auto tables = Wiimote::ExtCrypto::FromKey(key)) {
+            tables->Encrypt(nunchuk.data(), 0x08, nunchuk.size());
+        }
+    }
+    for (size_t i = 0; i < bytes; ++i) {
+        out.push_back(i < nunchuk.size() ? nunchuk[i] : 0x00);
+    }
+}
+
+} // namespace Bluetooth
diff --git a/runtime/src/hle/bluetooth/emulated_remote_host.cpp b/runtime/src/hle/bluetooth/emulated_remote_host.cpp
new file mode 100644
index 0000000..0230f3a
--- /dev/null
+++ b/runtime/src/hle/bluetooth/emulated_remote_host.cpp
@@ -0,0 +1,191 @@
+// Routes the first remote slot to the emulated Wii Remote (emulated_remote.h) for a foreign game while
+// no real remote is attached there, and feeds it the PC's controls: the GameCube pad as the runtime's
+// input bindings map it (F10), and the mouse as the pointer, its buttons as A and B.
+
+#include "bluetooth/emulated_remote_host.h"
+
+#include "bluetooth/emulated_remote.h"
+#include "guest_abi/guest_region.h"
+#include "input_bindings.h"
+#include "runtime_log.h"
+#include "wiimote_host.h"
+
+#include <SDL3/SDL_mouse.h>
+#include <SDL3/SDL_video.h>
+#include <dolphin/pad.h>
+
+#include <chrono>
+
+namespace Bluetooth {
+namespace {
+
+constexpr size_t kEmulatedSlot = 0;
+constexpr uint64_t kSampleIntervalUs = 4000;
+
+uint64_t NowUs() {
+    using namespace std::chrono;
+    return static_cast<uint64_t>(duration_cast<microseconds>(steady_clock::now().time_since_epoch()).count());
+}
+
+GameCubePad ReadFirstGameCubePad() {
+    static bool padStarted = false;
+    if (!padStarted) {
+        // The game may never start the GameCube pads itself; PADInit only once.
+        PADInit();
+        padStarted = true;
+    }
+    PADStatus statuses[PAD_CHANMAX]{};
+    PADRead(statuses);
+    InputBindings::Apply(statuses);
+    const PADStatus& status = statuses[0];
+    GameCubePad pad;
+    pad.connected = status.err == PAD_ERR_NONE;
+    pad.buttons = status.button;
+    pad.stickX = status.stickX;
+    pad.stickY = status.stickY;
+    pad.substickX = status.substickX;
+    pad.substickY = status.substickY;
+    pad.triggerL = status.triggerL;
+    pad.triggerR = status.triggerR;
+    return pad;
+}
+
+EmulatedInput ReadControls() {
+    if (InputBindings::InputBlocked()) {
+        // The settings overlay owns the controls: the remote is at rest.
+        return {};
+    }
+    EmulatedInput input = MapGameCubePad(ReadFirstGameCubePad());
+
+    float x = 0.0f;
+    float y = 0.0f;
+    const SDL_MouseButtonFlags mouse = SDL_GetMouseState(&x, &y);
+    SDL_Window* window = SDL_GetMouseFocus();
+    int width = 0;
+    int height = 0;
+    if (window != nullptr && SDL_GetWindowSize(window, &width, &height) && width > 0 && height > 0 &&
+        x >= 0.0f && y >= 0.0f && x < width && y < height) {
+        input.pointerValid = true;
+        input.pointerX = x / width * 2.0f - 1.0f;
+        input.pointerY = y / height * 2.0f - 1.0f;
+        if ((mouse & SDL_BUTTON_LMASK) != 0) input.buttons |= RemoteButton::kA;
+        if ((mouse & SDL_BUTTON_RMASK) != 0) input.buttons |= RemoteButton::kB;
+    }
+    return input;
+}
+
+class Host final : public RemoteHost {
+public:
+    explicit Host(RemoteHost& real) : m_real(real) {}
+
+    bool IsAttached(size_t slot) const override {
+        return Emulates(slot) || m_real.IsAttached(slot);
+    }
+
+    bool ConsumeWake(size_t slot) override {
+        if (!Emulates(slot)) {
+            return m_real.ConsumeWake(slot);
+        }
+        // Like a real remote: it asks to connect once at start, and again after the game let it go
+        // when a button is pressed.
+        if (!m_woken) {
+            m_woken = true;
+            return true;
+        }
+        if (m_releasedByGame && Sample().buttons != 0) {
+            m_releasedByGame = false;
+            return true;
+        }
+        return false;
+    }
+
+    bool PopInputReport(size_t slot, std::vector<uint8_t>& report) override {
+        if (!Emulates(slot)) {
+            return m_real.PopInputReport(slot, report);
+        }
+        const uint64_t now = NowUs();
+        m_remote.SetInput(Sample(now));
+        return m_remote.PopInputReport(report, now);
+    }
+
+    void SendOutputReport(size_t slot, const uint8_t* report, size_t size) override {
+        if (!Emulates(slot)) {
+            m_real.SendOutputReport(slot, report, size);
+            return;
+        }
+        const uint8_t mode = m_remote.ReportingMode();
+        const bool camera = m_remote.IrCameraOn();
+        m_remote.HandleOutputReport(report, size);
+        // What the game asks of the remote says whether it reads the pointer at all: only the modes with
+        // IR bytes (0x33, 0x36, 0x37, 0x3E/0x3F) carry it, and only with the camera on.
+        if (m_remote.ReportingMode() != mode || m_remote.IrCameraOn() != camera) {
+            RT_LOG(RT_TAG_HLE) << "Emulated Wii Remote: the game asks for report 0x" << std::hex
+                               << static_cast<int>(m_remote.ReportingMode()) << std::dec << ", IR camera "
+                               << (m_remote.IrCameraOn() ? "on" : "off") << std::endl;
+        }
+    }
+
+    void OnLinkStateChanged(size_t slot, LinkState state) override {
+        if (!Emulates(slot)) {
+            m_real.OnLinkStateChanged(slot, state);
+            return;
+        }
+        if (state == LinkState::Ready && m_link != LinkState::Ready) {
+            m_remote.Reset();
+            RT_LOG(RT_TAG_HLE) << "Emulated Wii Remote with Nunchuk connected to the game "
+                                  "(GameCube pad mapping and mouse)" << std::endl;
+        }
+        m_link = state;
+    }
+
+    void OnGuestDisconnect(size_t slot) override {
+        if (!Emulates(slot)) {
+            m_real.OnGuestDisconnect(slot);
+            return;
+        }
+        m_releasedByGame = true;
+    }
+
+    void OnGuestInquiry(bool active) override {
+        m_real.OnGuestInquiry(active);
+    }
+
+    const char* DeviceName(size_t slot) const override {
+        return Emulates(slot) ? "Nintendo RVL-CNT-01" : m_real.DeviceName(slot);
+    }
+
+private:
+    // The first slot is emulated for a foreign game while no real remote is attached there, and stays
+    // emulated while its connection is up, so a remote that arrives meanwhile waits for the next one.
+    bool Emulates(size_t slot) const {
+        if (slot != kEmulatedSlot || !GuestRegion::IsForeignGame()) {
+            return false;
+        }
+        return m_link != LinkState::Down || !m_real.IsAttached(slot);
+    }
+
+    const EmulatedInput& Sample(uint64_t now = NowUs()) {
+        if (now - m_sampledUs >= kSampleIntervalUs) {
+            m_input = ReadControls();
+            m_sampledUs = now;
+        }
+        return m_input;
+    }
+
+    RemoteHost& m_real;
+    EmulatedRemote m_remote;
+    EmulatedInput m_input;
+    uint64_t m_sampledUs = 0;
+    LinkState m_link = LinkState::Down;
+    bool m_woken = false;
+    bool m_releasedByGame = false;
+};
+
+} // namespace
+
+RemoteHost& RemoteHostForThisGame() {
+    static Host host(Wiimote::Host());
+    return host;
+}
+
+} // namespace Bluetooth
