+void DrawTestPanel() {
+    int chosen = g_chosenCandidate.load();
+    static std::string result;
+    ImGui::TextWrapped("For testing the mod. Load a game, choose a candidate and press Ready to propose: "
+                       "all hearts, the heart events up to the confession, the house built up and a Blue "
+                       "Feather in your hands. Then save in the game. It changes that game's progress.");
