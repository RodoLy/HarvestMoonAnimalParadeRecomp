+// Where the scene goes.
+
+// The disc's unused test scenes that carry the adoption (script/test/sample/), by file number.
+// The question (in place of L000015 and L000029):
+constexpr uint32_t kFirstQuestionFile = 18426;   // sample_125.opb
+constexpr uint32_t kSecondQuestionFile = 18427;  // sample_126.opb
+// The Goddess with the baby (in place of the births, L000016 and L000030):
+constexpr uint32_t kFirstGoddessForMenFile = 18428;    // sample_127.opb
+constexpr uint32_t kFirstGoddessForWomenFile = 18423;  // sample_122.opb
+constexpr uint32_t kSecondGoddessFile = 18424;         // sample_123.opb
+// Previews (kTestAdoptionKey): one per candidate, sample_100.opb on (files 18401 on).
+constexpr uint32_t kFirstPreviewFile = 18401;
+// The wedding with its last shot changed (sample_120.opb and sample_121.opb).
+constexpr uint32_t kWeddingOfBridesFile = 18421;
+constexpr uint32_t kWeddingOfGroomsFile = 18422;
+
+// The characters of the scene, as the game's scenes name them.
+constexpr uint32_t kPlayer = 0;
+constexpr uint32_t kSpouse = static_cast<uint32_t>(-10);
+constexpr uint32_t kGoddess = 52;
+constexpr uint32_t kFirstChild = 62;
+constexpr uint32_t kSecondChild = 63;
+
+// A spouse's events about the children, and what the scene needs to know of them.
+struct Spouse {
+    uint32_t character = 0;
+    long askEvent[2] = {-1, -1};    // L000015 and L000029: the question
+    long birthEvent[2] = {-1, -1};  // L000016 and L000030: the birth
+    uint32_t askFlag[2] = {};       // each event's own "done" flag
+    uint32_t birthFlag[2] = {};
+    int preferredSex = 0;           // the first child they ask for when the player lets them choose
+};
+
+std::vector<Spouse> g_spouses;
+
+struct Adoption {
+    uint32_t character;
+    int child;     // 0 the first, 1 the second
+    bool goddess;  // the birth's event (the Goddess's half), not the question's
+    int preview;   // which preview file shows this character
+};
+std::map<uint32_t, Adoption> g_adoptions;  // by the question's and the birth's events
+std::map<uint32_t, uint32_t> g_weddings;    // a candidate's wedding event: the candidate
+bool g_testAdoption = false;
+uint32_t g_sceneBaby = 0;  // the baby of the last adoption scene started (62 or 63)
+
+} // namespace
+
+// 0x801320B4 (event in r3): the file of the scene the event plays.
+extern "C" void AnimalParadeEventScene(CpuContext* ctx) {
+    const uint32_t event = ctx->gpr[3];
+    GuestFunctions::BaseTranslation(0x801320B4u)(ctx);
+    if (!Enabled()) {
+        return;
+    }
+    if (Memory::Read32(kGameState) == 0) {
+        return;
+    }
+    const auto wedding = g_weddings.find(event);
+    if (wedding != g_weddings.end()) {
+        const int partnerSex = NaturalPartnerSex(wedding->second);
+        if (partnerSex != static_cast<int>(Memory::Read32(VariableAddress(0x23)))) {
+            ctx->gpr[3] = partnerSex == kMan ? kWeddingOfBridesFile : kWeddingOfGroomsFile;
+        }
+        return;
+    }
+    const auto found = g_adoptions.find(event);
+    if (found == g_adoptions.end()) {
+        return;
+    }
+    if (g_testAdoption && !found->second.goddess && found->second.child == 0 &&
+        found->second.character == AdoptionPreviewCharacter()) {
+        ctx->gpr[3] = kFirstPreviewFile + static_cast<uint32_t>(found->second.preview);
+        g_sceneBaby = kFirstChild;
+        return;
+    }
+    const int playerSex = static_cast<int>(Memory::Read32(VariableAddress(0x23)));
+    if (NaturalPartnerSex(found->second.character) == playerSex) {
+        return;  // a couple the original game already has: its own scenes
+    }
+    const Adoption& adoption = found->second;
+    if (!adoption.goddess) {
+        ctx->gpr[3] = adoption.child == 0 ? kFirstQuestionFile : kSecondQuestionFile;
+        return;
+    }
+    if (adoption.child == 0) {
+        ctx->gpr[3] = playerSex == kMan ? kFirstGoddessForMenFile : kFirstGoddessForWomenFile;
+    } else {
+        ctx->gpr[3] = kSecondGoddessFile;
+    }
+    g_sceneBaby = adoption.child == 0 ? kFirstChild : kSecondChild;
+}
+FOREIGN_GAME_WRAPPER(RBIEE9, 801320B4, AnimalParadeEventScene);
+
+// 0x8020DA98: the scene command 0x3C2, the name entry; its arguments (at r6) are what is named and
+// who. "2, -16" names the family's child 0: the character in the family table at 0x805021F0
+// (0x8010CBDC). The game fills that table on the birth's day, when the Goddess's scene plays;
+// the preview is a bedtime scene, where the table still says 0, and 0 is the player: the baby's
+// name would become the player's. While an adoption scene names its baby and the table does not
+// say it, the table says the baby.
+extern "C" void AnimalParadeNameEntry(CpuContext* ctx) {
+    constexpr uint32_t kFamilyChildren = 0x805021F0u;
+    const uint32_t what = Memory::Read32(ctx->gpr[6]);
+    const uint32_t who = Memory::Read32(ctx->gpr[6] + 4);
+    const uint32_t child = Memory::Read32(kFamilyChildren);
+    const bool ours = Enabled() && g_sceneBaby != 0 && what == 2 && who == static_cast<uint32_t>(-16) &&
+                      child != kFirstChild && child != kSecondChild;
+    if (ours) {
+        Memory::Write32(kFamilyChildren, g_sceneBaby);
+    }
+    GuestFunctions::BaseTranslation(0x8020DA98u)(ctx);
+    if (ours) {
+        Memory::Write32(kFamilyChildren, child);
+    }
+}
+FOREIGN_GAME_WRAPPER(RBIEE9, 8020DA98, AnimalParadeNameEntry);
