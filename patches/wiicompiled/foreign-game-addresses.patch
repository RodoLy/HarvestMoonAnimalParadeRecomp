diff --git a/runtime/include/game_mods.h b/runtime/include/game_mods.h
new file mode 100644
index 0000000..34af5c1
--- /dev/null
+++ b/runtime/include/game_mods.h
@@ -0,0 +1,50 @@
+#pragma once
+
+// Game mods: optional changes to a game, each with a switch in Config.toml [mods] (off unless its
+// line says true). A mod can change the game's code with FOREIGN_GAME_WRAPPER (hle_stubs.h) and its
+// files with a disc overlay: a folder shaped like the disc's files/ that the DVD layer reads on top
+// of the disc. Mods never ship the game's files; they make their copies from the player's own disc.
+
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace GameMods {
+
+// A mod's files for this run: write them under Folder(mod), then register it.
+std::filesystem::path Folder(const std::string& mod);
+void RegisterDiscOverlay(std::filesystem::path root);
+
+// Every enabled mod prepares its files the first time this is called (the DVD layer calls it while
+// it looks for overlays), so a mod's preparation runs once and before the disc is read.
+const std::vector<std::filesystem::path>& DiscOverlayRoots();
+
+// A mod's part of the F10 menu (a "Mods" menu appears when any mod has one available).
+struct SettingsPanel {
+    const char* name;
+    bool (*available)();
+    void (*draw)();
+};
+void RegisterSettingsPanel(SettingsPanel panel);
+bool HasSettings();
+void DrawSettings();
+
+// A game's cheats in the F10 menu (a "Cheats" menu appears when any game has one available). Kept
+// apart from the mods' menu so that cheats are never mixed in with the mods.
+void RegisterCheatsPanel(SettingsPanel panel);
+bool HasCheats();
+void DrawCheats();
+
+// A mod that uses the right stick itself (the free camera): the game then never gets it as the
+// D-pad.
+void SetRightStickTaken(bool taken);
+
+bool RightStickTaken();
+
+// A mod's preparation: registered at startup by each mod's source file.
+using PrepareFn = void (*)();
+struct Registration {
+    Registration(PrepareFn prepare);
+};
+
+} // namespace GameMods
