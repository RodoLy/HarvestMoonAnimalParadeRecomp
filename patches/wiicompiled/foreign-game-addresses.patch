+constexpr QuestionLines kFirstQuestion{Slot(0), Slot(1), Slot(2), Slot(3), Slot(4), Slot(5), Slot(6), Slot(7), Slot(10), Slot(9)};
+constexpr QuestionLines kSecondQuestion{Slot(11), Slot(1), Slot(2), Slot(12), Slot(4), Slot(5), Slot(13), Slot(14), Slot(15), Slot(9)};
+constexpr uint32_t kFirstOpinion = Slot(8);
+constexpr uint32_t kSecondOpinionBoy = Slot(16);
