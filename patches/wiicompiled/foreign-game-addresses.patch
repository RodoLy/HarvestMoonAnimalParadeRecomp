+// ---------------------------------------------------------------------------------------------
+// Testing: F10 > Mods > "Ready to propose" puts the loaded game where the player can propose to a
+// candidate, without playing the weeks it takes, so the mod can be tried. It writes the game's
+// state directly; save in the game afterwards to keep it.
+//
+// What the proposal checks are the conditions of each candidate's proposal event in
+// event/prm_love.epc (for example Gill's 1797); where the game keeps them is described in
+// romance_any_gender.h. The Blue Feather is item 1269 (0x4F5); the gift code at 0x801D5E1C reads
+// the item the player holds from the player's object, *(0x80501D58 + 0x50), at + 0x650.
+
+constexpr uint32_t kVillagerTable = 0x8050AA24u;
+constexpr uint32_t kPlayerObject = 0x80501D58u + 0x50u;
+constexpr uint32_t kBlueFeather = 1269;
+
+uint32_t VillagerValueAddress(uint32_t character, uint32_t value) {
+    return Memory::Read32(kGameState) + (character - 1) * 0x400 + 0x1B98 + TableOffset(kVillagerTable, value);
+}
+
+// The event flags a candidate's heart events before the proposal expect to be set: every flag that
+// one of those events needs to be 1 in its conditions (prm_love.epc). That leaves the confession
+// (L000003a) to play: its own flag is only asked for by the proposal, and the confession scene is
+// what makes the candidate the player's sweetheart, which the proposal checks. A candidate's events
+// are the ones varSet_love*.db gives that character's messages; their message names count up, and
+// number 5 (GIL_L000005 for Gill) is the proposal, so these are L000000 to L000004. The file is
+// "EVTP", a count and {event, offset, size} rows, then each event's "EVCD" block: a count at 8 and
+// from 0x14 conditions of six numbers; {0, flag, -1, 0, 0, value} asks for a flag.
+//
+// It also gives the flags to clear: the ones the confession (L000003a) and the proposal (L000005)
+// need to be 0, their own "already seen", so both play again in a game where they were marked.
+std::vector<uint32_t> HeartEventFlags(uint32_t character, std::vector<uint32_t>& toClear) {
+    const std::filesystem::path eventFolder = RuntimeConfigFile::ResolvedDvdRoot() / "files" / "event";
+    std::set<long> events;
+    std::set<long> replayed;
+    for (const char* name : {"varSet_loveM.db", "varSet_loveW.db"}) {
+        for (const std::string& block : Blocks(ReadFile(eventFolder / name))) {
+            static const std::regex beforeProposal("msg0_0\\s+\"[A-Z]+_L00000[0-4]");
+            static const std::regex toReplay("msg0_0\\s+\"[A-Z]+_L00000(3a|5)\"");
+            if (Number(block, "chara0") != static_cast<long>(character)) {
+                continue;
+            }
+            if (std::regex_search(block, beforeProposal)) {
+                events.insert(Number(block, "evtNo"));
+            }
+            if (std::regex_search(block, toReplay)) {
+                replayed.insert(Number(block, "evtNo"));
+            }
+        }
+    }
+    std::set<uint32_t> flags;
+    std::set<uint32_t> cleared;
+    const std::string data = ReadFile(eventFolder / "prm_love.epc");
+    if (data.size() < 20 || data.compare(0, 4, "EVTP") != 0) {
+        return {};
+    }
+    const uint32_t count = ReadBigEndian32(data, 8);
+    const size_t blocks = 20 + 12 * size_t(count);
+    for (uint32_t i = 0; i < count && blocks <= data.size(); ++i) {
+        const size_t row = 20 + 12 * size_t(i);
+        const long event = static_cast<long>(ReadBigEndian32(data, row));
+        if (events.count(event) == 0 && replayed.count(event) == 0) {
+            continue;
+        }
+        const size_t block = blocks + ReadBigEndian32(data, row + 4);
+        const size_t size = ReadBigEndian32(data, row + 8);
+        if (block + size > data.size() || size < 0x14) {
+            continue;
+        }
+        const uint32_t conditions = ReadBigEndian32(data, block + 8);
+        for (uint32_t c = 0; c < conditions && 0x14 + 24 * size_t(c + 1) <= size; ++c) {
+            const size_t at = block + 0x14 + 24 * size_t(c);
+            if (ReadBigEndian32(data, at) != 0) {
+                continue;
+            }
+            if (events.count(event) != 0 && ReadBigEndian32(data, at + 20) == 1) {
+                flags.insert(ReadBigEndian32(data, at + 4));
+            }
+            if (replayed.count(event) != 0 && ReadBigEndian32(data, at + 20) == 0) {
+                cleared.insert(ReadBigEndian32(data, at + 4));
+            }
+        }
+    }
+    for (const uint32_t flag : flags) {
+        cleared.erase(flag);
+    }
+    toClear.assign(cleared.begin(), cleared.end());
+    return {flags.begin(), flags.end()};
+}
+
+// Gives the player a Blue Feather the way the game's scenes give items (command 0x306, 0x8010D8A0):
+// {item, count} pairs of 16 bits in a queue of 30 at 0x80502180 + 0x9C, which the game moves into
+// the rucksack at once (an empty slot is item -1). The proposal asks for one in the rucksack
+// ({10, 1269, 0, >=, 0, 1} in prm_love.epc): a feather only in the hands is given as a plain gift.
+// Then it puts the feather in the player's hands; false while the player is not on screen.
+bool HoldBlueFeather() {
+    constexpr uint32_t kGivenItems = 0x80502180u + 0x9Cu;
+    for (uint32_t slot = 0; slot < 30; ++slot) {
+        const uint32_t at = kGivenItems + 4 * slot;
+        if (static_cast<int16_t>(Memory::Read16(at)) == -1) {
+            Memory::Write16(at, static_cast<uint16_t>(kBlueFeather));
+            Memory::Write16(at + 2, 1);
+            break;
+        }
+    }
+    const uint32_t player = Memory::Read32(kPlayerObject);
+    if (player == 0 || !Memory::Contains(player + 0x650, 4)) {
+        return false;
+    }
+    Memory::Write32(player + 0x650, kBlueFeather);
+    return true;
+}
+
+// "Finish the story": the story's events are event/trig_main.db, with `attr "main1"` and "main2" for
+// its first two parts (ringing the bells) and "main3" for what comes after; the part the game is in
+// is entry 0 of the story table, state + 0x1798 + offset (table 0x8050AAB0, read by 0x80112308), and
+// 0x8012E07C compares it (0, 1, 2) with those attrs. The button sets every event flag the first two
+// parts' conditions (prm_main.epc) look at, as if all of it had happened, and moves the story on to
+// the third part. Small flag numbers (below 1400) are counters shared with the rest of the game and
+// are left alone, as are flags the conditions want at 2 or more. It also marks every villager as met.
+constexpr uint32_t kStoryTable = 0x8050AAB0u;
+
+std::vector<uint32_t> StoryFlags() {
+    const std::filesystem::path eventFolder = RuntimeConfigFile::ResolvedDvdRoot() / "files" / "event";
+    std::set<long> events;
+    static const std::regex firstParts("attr\\s+\"main[12]\"");
+    for (const std::string& block : Blocks(ReadFile(eventFolder / "trig_main.db"))) {
+        if (std::regex_search(block, firstParts)) {
+            events.insert(Number(block, "evtNo"));
+        }
+    }
+    std::set<uint32_t> flags;
+    const std::string data = ReadFile(eventFolder / "prm_main.epc");
+    if (data.size() < 20 || data.compare(0, 4, "EVTP") != 0) {
+        return {};
+    }
+    const uint32_t count = ReadBigEndian32(data, 8);
+    const size_t blocks = 20 + 12 * size_t(count);
+    for (uint32_t i = 0; i < count && blocks <= data.size(); ++i) {
+        const size_t row = 20 + 12 * size_t(i);
+        if (events.count(static_cast<long>(ReadBigEndian32(data, row))) == 0) {
+            continue;
+        }
+        const size_t block = blocks + ReadBigEndian32(data, row + 4);
+        const size_t size = ReadBigEndian32(data, row + 8);
+        if (block + size > data.size() || size < 0x14) {
+            continue;
+        }
+        const uint32_t conditions = ReadBigEndian32(data, block + 8);
+        for (uint32_t c = 0; c < conditions && 0x14 + 24 * size_t(c + 1) <= size; ++c) {
+            const size_t at = block + 0x14 + 24 * size_t(c);
+            const uint32_t flag = ReadBigEndian32(data, at + 4);
+            if (ReadBigEndian32(data, at) == 0 && ReadBigEndian32(data, at + 20) <= 1 && flag >= 1400) {
+                flags.insert(flag);
+            }
+        }
+    }
+    return {flags.begin(), flags.end()};
+}
+
+bool GameLoaded() {
+    const uint32_t state = Memory::Read32(kGameState);
+    return state != 0 && Memory::Contains(state, 0x1000);
+}
