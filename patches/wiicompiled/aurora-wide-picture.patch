+// Every path that hands vertices to the renderer calls this before its draw is recorded, so the
+// uniform block of a flat draw always matches the draw itself. A path that skipped it would leave
+// the answer of the draw before: a text drawn right after a fade would then come out stretched.
+static void classify_ortho_draw(const u8* vertices, u16 vtxCount, u32 vtxStride, GXVtxFmt fmt) noexcept {
+  if (g_gxState.projType != GX_ORTHOGRAPHIC || wide_picture_factor() <= 1.f) {
+    return;
+  }
+  const bool fillsWidth = ortho_draw_fills_width(vertices, vtxCount, vtxStride, fmt);
+  if (fillsWidth != g_gxState.orthoDrawFillsWidth) {
+    g_gxState.orthoDrawFillsWidth = fillsWidth;
+    g_gxState.dirty |= DirtyUniform;
+  }
+}
