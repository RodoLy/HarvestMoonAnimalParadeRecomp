+// Wide picture draws the game's 4:3 frame in the middle of a wider one (see wide_picture_factor).
+// That suits what a game draws flat on the screen - a clock, a text box - but not a draw that covers
+// the whole frame: a fade to black, or the scene drawn back from a copy, has to reach the sides too.
+// This tells the two apart by where the vertices of an orthographic draw land across the frame.
+static bool ortho_draw_fills_width(const u8* vertices, u16 vtxCount, u32 vtxStride, GXVtxFmt fmt) noexcept {
+  const auto& state = g_gxState;
+  const GXAttrType positionSource = state.vtxDesc[GX_VA_POS];
+  if (positionSource == GX_NONE || vtxCount == 0 || vtxStride == 0) {
+    return false;
+  }
+  // The matrix indices come first in a vertex, one byte each, and the position right after them.
+  u32 positionOffset = 0;
+  for (int i = GX_VA_PNMTXIDX; i < GX_VA_POS; ++i) {
+    positionOffset += state.vtxDesc[i] != GX_NONE ? 1 : 0;
+  }
+  const auto& positionFormat = state.vtxFmts[fmt].attrs[GX_VA_POS];
+  const u32 components = positionFormat.cnt == GX_POS_XY ? 2 : 3;
+  const u32 componentSize = comp_type_size(GX_VA_POS, positionFormat.type);
+  const bool indexed = positionSource == GX_INDEX8 || positionSource == GX_INDEX16;
+  const bool matrixPerVertex = state.vtxDesc[GX_VA_PNMTXIDX] == GX_DIRECT;
+  const auto& array = state.arrays[GX_VA_POS];
+
+  float leftmost = std::numeric_limits<float>::infinity();
+  float rightmost = -std::numeric_limits<float>::infinity();
+  for (u16 i = 0; i < vtxCount; ++i) {
+    const u8* vertex = vertices + static_cast<size_t>(i) * vtxStride;
+    const u8* source = vertex + positionOffset;
+    bool littleEndian = false;
+    if (indexed) {
+      const u32 index = positionSource == GX_INDEX8 ? source[0] : static_cast<u32>((source[0] << 8) | source[1]);
+      const size_t start = static_cast<size_t>(index) * array.stride;
+      if (array.data == nullptr || start + components * componentSize > array.size) {
+        return false;
+      }
+      source = static_cast<const u8*>(array.data) + start;
+      littleEndian = array.le;
+    }
+    float position[3] = {0.f, 0.f, 0.f};
+    for (u32 c = 0; c < components; ++c) {
+      position[c] =
+          read_position_component(source + c * componentSize, positionFormat.type, positionFormat.frac, littleEndian);
+    }
+    const u32 matrix = std::min<u32>(matrixPerVertex ? (vertex[0] & 0x3fu) / 3u : state.currentPnMtx, MaxPnMtx - 1);
+    const auto& row = state.pnMtx[matrix].pos.m0;
+    const float viewX = row[0] * position[0] + row[1] * position[1] + row[2] * position[2] + row[3];
+    // -1 is the left edge of the frame and 1 the right one.
+    const float frameX = state.proj.m0[0] * viewX + state.proj.m0[3];
+    // A draw that covers the frame lies right on its edges. A position far outside them (or not a
+    // number at all) means this vertex was not read the way the game laid it out, and a wrong
+    // guess here would stretch a letter of text out to the side; so the draw keeps the safe answer.
+    if (!(frameX >= -1.1f && frameX <= 1.1f)) {
+      static int s_reported = 0;
+      if (s_reported < 30) {
+        ++s_reported;
+        Log.info("wide picture: flat draw of {} vertices read outside the frame (x={}, source={}, type={}, "
+                 "count={}, matrix={}); kept in the middle",
+                 vtxCount, frameX, static_cast<int>(positionSource), static_cast<int>(positionFormat.type),
+                 static_cast<int>(positionFormat.cnt), matrix);
+      }
+      return false;
+    }
+    leftmost = std::min(leftmost, frameX);
+    rightmost = std::max(rightmost, frameX);
+  }
+  const bool fills = leftmost <= -WidePictureFullWidth && rightmost >= WidePictureFullWidth;
+  if (fills) {
+    static int s_reported = 0;
+    if (s_reported < 30) {
+      ++s_reported;
+      Log.info("wide picture: flat draw of {} vertices covers the frame (x {} to {}, source={}, type={})", vtxCount,
+               leftmost, rightmost, static_cast<int>(positionSource), static_cast<int>(positionFormat.type));
+    }
+  }
+  return fills;
+}
