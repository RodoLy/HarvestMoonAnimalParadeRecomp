+// The count to expect is the fewest of the frames before: when a game makes a copy more only now and
+// then, the frames after would otherwise wait for a copy that never comes and draw their text box as if
+// it were part of that work (stretched, with holes where the sky shows through). Looking back on a few
+// frames rather than one keeps that from happening when the extra copy lasts a frame or two.
+u32 wide_copies_expected() noexcept {
+  const auto& before = g_gxState.texCopiesFramesBefore;
+  return *std::min_element(before.begin(), before.end());
+}
+
+// The frame's copies of a part of the frame are not all made yet.
+bool wide_copies_pending() noexcept { return g_gxState.texCopiesThisFrame < wide_copies_expected(); }
+
+void finish_wide_frame() noexcept {
+  auto& before = g_gxState.texCopiesFramesBefore;
+  const u32 made = g_gxState.texCopiesThisFrame;
+  const u32 expected = wide_copies_expected();
+  if (g_gxState.wideGameAspect > 0.f && made < expected) {
+    // The first few, then one in a thousand: enough to tell from a log how often it happens.
+    static u64 s_short = 0;
+    if (s_short < 10 || s_short % 1000 == 0) {
+      Log.warn("wide picture: a frame made {} copies of a part of itself, fewer than the {} expected "
+               "(frames before: {}, {}, {}, {}); what it held back is placed at its end ({} times so far)",
+               made, expected, before[0], before[1], before[2], before[3], s_short + 1);
+    }
+    ++s_short;
+  }
+  std::copy_backward(before.begin(), before.end() - 1, before.end());
+  before[0] = made;
+  g_gxState.texCopiesThisFrame = 0;
+}
