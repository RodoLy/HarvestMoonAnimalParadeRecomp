+void hold_wide_draw(const gfx::Range& uniform, u32 projectionOffset) noexcept {
+  auto& heldDraws = g_gxState.wideHeldDraws;
+  // Those of a frame that ended without a copy to the display are of no use any more.
+  if (!heldDraws.empty() && heldDraws.back().frame != gfx::current_frame()) {
+    heldDraws.clear();
+  }
+  const auto& area = g_gxState.orthoDrawArea;
+  heldDraws.push_back(WideHeldDraw{
+      .uniform = uniform,
+      .projectionOffset = projectionOffset,
+      .area = area,
+      .areaKnown = !area.empty,
+      .factor = wide_frame_factor(),
+      .frame = gfx::current_frame(),
+  });
+}
+
+void read_back_wide_draws(const WideCopyArea& source) noexcept {
+  for (auto& held : g_gxState.wideHeldDraws) {
+    // A draw whose place is not known is taken as read by any copy after it, as before.
+    if (!held.areaKnown ||
+        source.overlaps(held.area.left, held.area.top, held.area.right, held.area.bottom)) {
+      held.readBack = true;
+    }
+  }
+}
+
+void release_wide_draws() noexcept {
+  const u32 frame = gfx::current_frame();
+  for (const auto& held : g_gxState.wideHeldDraws) {
+    // A draw of an earlier frame went to the GPU with that frame already.
+    if (held.readBack || held.frame != frame) {
+      continue;
+    }
+    // What build_uniform does to a flat draw that is not read back: its horizontal positions are
+    // brought back towards the middle (the first row of the projection, its scale and its offset).
+    auto* projection = gfx::mutable_uniform_data(held.uniform) + held.projectionOffset;
+    for (const size_t column : {size_t{0}, size_t{3}}) {
+      float value;
+      std::memcpy(&value, projection + column * sizeof(float), sizeof(value));
+      value /= held.factor;
+      std::memcpy(projection + column * sizeof(float), &value, sizeof(value));
+    }
+  }
+  g_gxState.wideHeldDraws.clear();
+}
