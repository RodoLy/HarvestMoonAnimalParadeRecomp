+bool wide_draw_held() noexcept {
+  return g_gxState.projType == GX_ORTHOGRAPHIC && !g_gxState.orthoDrawFillsWidth && wide_frame_factor() > 1.f &&
+         wide_picture_factor() == 1.f;
+}
