 // Vertices a primitive actually uses: incomplete trailing primitives are never drawn, so they
 // cannot join a later merged draw either.
+// One component of a vertex position, as the game stored it: big-endian in the command stream,
+// either order in an array, and a fixed-point integer unless it is a float.
+static float read_position_component(const u8* data, GXCompType type, u8 frac, bool littleEndian) noexcept {
+  const auto read16 = [&]() -> u16 {
+    return littleEndian ? static_cast<u16>(data[0] | (data[1] << 8)) : static_cast<u16>((data[0] << 8) | data[1]);
+  };
+  const float scale = 1.f / static_cast<float>(1u << (frac & 31u));
+  switch (type) {
+  case GX_U8:
+    return static_cast<float>(data[0]) * scale;
+  case GX_S8:
+    return static_cast<float>(static_cast<s8>(data[0])) * scale;
+  case GX_U16:
+    return static_cast<float>(read16()) * scale;
+  case GX_S16:
+    return static_cast<float>(static_cast<s16>(read16())) * scale;
+  default: {
+    u32 bits = littleEndian ? static_cast<u32>(data[0] | (data[1] << 8) | (data[2] << 16) | (static_cast<u32>(data[3]) << 24))
+                            : static_cast<u32>((static_cast<u32>(data[0]) << 24) | (data[1] << 16) | (data[2] << 8) | data[3]);
+    float value;
+    std::memcpy(&value, &bits, sizeof(value));
+    return value;
+  }
+  }
+}
