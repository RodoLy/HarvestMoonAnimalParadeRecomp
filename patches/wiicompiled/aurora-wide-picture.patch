+// Whether a flat draw lies clear of every place the frame before copied a part of itself from. Such
+// a draw is not one the game reads back, even before the frame's last copy (see wide_picture_factor).
+static WideCopyArea ortho_draw_area(const OrthoDrawExtent& extent) noexcept {
+  WideCopyArea area;
+  if (!extent.known || !(extent.bottom <= extent.top)) {
+    return area;
+  }
+  // From the frame's -1..1 to the logical EFB pixels the copies are given in.
+  const auto& viewport = g_gxState.logicalViewport;
+  area.add(viewport.left + (extent.left + 1.f) * 0.5f * viewport.width,
+           viewport.top + (1.f - extent.top) * 0.5f * viewport.height,
+           viewport.left + (extent.right + 1.f) * 0.5f * viewport.width,
+           viewport.top + (1.f - extent.bottom) * 0.5f * viewport.height);
+  return area;
+}
+
+static bool ortho_draw_clear_of_copies(const WideCopyArea& draw) noexcept {
+  const auto& area = g_gxState.texCopyAreaLastFrame;
+  if (draw.empty || area.empty) {
+    return false;
+  }
+  // A pixel of slack, for an edge that lands right on a copy's.
+  constexpr float Slack = 1.f;
+  return !area.overlaps(draw.left - Slack, draw.top - Slack, draw.right + Slack, draw.bottom + Slack);
+}
+
+// Every path that hands vertices to the renderer calls this before its draw is recorded, so the
+// uniform block of a flat draw always matches the draw itself. A path that skipped it would leave
+// the answer of the draw before: a text drawn right after a fade would then come out stretched.
+static void classify_ortho_draw(const u8* vertices, u16 vtxCount, u32 vtxStride, GXVtxFmt fmt) noexcept {
+  bool fillsWidth = false;
+  bool clearOfCopies = false;
+  if (g_gxState.projType == GX_ORTHOGRAPHIC && wide_frame_factor() > 1.f) {
+    const auto extent = measure_ortho_draw(vertices, vtxCount, vtxStride, fmt);
+    fillsWidth = ortho_draw_fills_width(extent, vtxCount);
+    g_gxState.orthoDrawArea = ortho_draw_area(extent);
+    clearOfCopies = wide_copies_pending() && ortho_draw_clear_of_copies(g_gxState.orthoDrawArea);
+  } else if (g_gxState.projType != GX_ORTHOGRAPHIC) {
+    // Only a flat draw is placed by its own answer; the rest keep the one they had.
+    fillsWidth = g_gxState.orthoDrawFillsWidth;
+  } else {
+    return;
+  }
+  if (fillsWidth != g_gxState.orthoDrawFillsWidth || clearOfCopies != g_gxState.orthoDrawClearOfCopies) {
+    g_gxState.orthoDrawFillsWidth = fillsWidth;
+    g_gxState.orthoDrawClearOfCopies = clearOfCopies;
+    g_gxState.dirty |= DirtyUniform;
+    refresh_wide_scissor();
+  }
+}
