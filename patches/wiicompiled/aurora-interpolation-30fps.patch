+// Slots inserted between two guest frames. One guest frame lasts `retraces` 60 Hz retraces, so the
+// target frame rate shows targetFps * retraces / 60 frames in that time, one of them the guest's own.
+uint32_t slots_for_target(uint32_t targetFps, uint32_t retraces) noexcept {
+  const uint32_t framesShown = targetFps * retraces / 60;
+  return framesShown > 1 ? std::min(framesShown - 1, MaxInterpolatedFrames) : 0;
+}
