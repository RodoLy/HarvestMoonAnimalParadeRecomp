+    /// <summary>
+    /// Non-volatile float registers (f14..f31) that a function reads as paired-single values before it
+    /// writes them, so they can only have been left that way by a caller. Some games keep running totals
+    /// in f22..f27 across a family of small helper functions (one clears them, one adds a term, one stores
+    /// them); the helpers read each other's results as pairs. Reading such a register as a scalar would
+    /// take the packed pair for a double, and every term but the last would be lost.
+    ///
+    /// Only the entry block is looked at, and only an arithmetic paired-single operation or a single-float
+    /// quantized store counts as a read: a pair store at the top of a function is the prologue saving a
+    /// callee-saved register, whatever it holds.
+    /// </summary>
+    private static uint ComputeEntryPairedSeed(IrFunction func)
+    {
+        var entry = func.Blocks.FirstOrDefault(
+            b => b.Label.Equals(func.EntryLabel, StringComparison.OrdinalIgnoreCase));
+        if (entry is null)
+        {
+            return 0u;
+        }
+
+        const uint nonVolatileFloatRegisters = 0xFFFFC000u; // f14..f31
+        var written = 0u;
+        var seed = 0u;
+        foreach (var ins in entry.Instructions)
+        {
+            if (ins is IrCall call && IsPairedConsumerTarget(call.Target))
+            {
+                var isQuantizedStore = call.Target.Equals("PPC_PsqSt", StringComparison.OrdinalIgnoreCase);
+                var storesSingleFloat = isQuantizedStore &&
+                    call.Arguments.Count > 2 &&
+                    call.Arguments[2] is { Kind: "const", Constant: 1 };
+                if (!isQuantizedStore || storesSingleFloat)
+                {
+                    foreach (var argument in call.Arguments)
+                    {
+                        if (argument is not { Kind: "register", RegisterName: { } name })
+                        {
+                            continue;
+                        }
+
+                        var bit = PairedFloatRegisterBit(GetRegisterBaseName(name));
+                        if (bit < 0 || (nonVolatileFloatRegisters & (1u << bit)) == 0 ||
+                            (written & (1u << bit)) != 0)
+                        {
+                            continue;
+                        }
+
+                        seed |= 1u << bit;
+                    }
+                }
+            }
+
+            foreach (var destination in InstructionFloatDestinations(ins))
+            {
+                var bit = PairedFloatRegisterBit(GetRegisterBaseName(destination));
+                if (bit >= 0)
+                {
+                    written |= 1u << bit;
+                }
+            }
+        }
+
+        return seed;
+    }
+
+    private static IEnumerable<string> InstructionFloatDestinations(IrInstruction ins)
+    {
+        switch (ins)
+        {
+            case IrCall { Destination: { Length: > 0 } d }: yield return d; break;
+            case IrAssign a: yield return a.Destination; break;
+            case IrBinary b: yield return b.Destination; break;
+            case IrLoad l: yield return l.Destination; break;
+            case IrResolvedLoad l: yield return l.Destination; break;
+            case IrResolvedPsqLoad l: yield return l.Destination; break;
+            case IrResolvedLoadPair p:
+                yield return p.FirstDestination;
+                yield return p.SecondDestination;
+                break;
+        }
+    }
+
